                 exist on stock.picking; those were dead and were dropped. --><xpath expr="//field[@name='partner_id']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><xpath expr="//field[@name='note']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><!-- Absorbed from print_conf_copies_pt: per-document print copies. --><xpath expr="//page[@name='extra']" position="inside"><group><group name="print_conf" string="Print Configurations"><field name="print_copies"/></group></group></xpath></field></record></odoo>
