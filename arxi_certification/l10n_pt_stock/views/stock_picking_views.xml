<odoo><record id="view_picking_form" model="ir.ui.view"><field name="name">stock.picking.form.inherited.l10n_pt_stock</field><field name="model">stock.picking</field><field name="priority">101</field><field name="inherit_id" ref="stock.view_picking_form"/><field name="arch" type="xml"><xpath expr="//field[@name='state']" position="before"><field name="is_pt_internal_deliverable" invisible="True"/><button name="action_create_at_transport" type="object" string="Create AT Transport Document" invisible="not is_pt_internal_deliverable"/></xpath><xpath expr="//div[@name='button_box']" position="inside"><button name="action_see_pt_transports" type="object" class="oe_stat_button" icon="fa-truck" invisible="pt_transport_count == 0 or not is_pt_internal_deliverable"><field name="pt_transport_count" widget="statinfo" string="PT Transports"/></button></xpath><!--Movement Name--><xpath expr="//h1" position="replace"><field name="pt_arxi_validated_date" invisible="True"/><div class="row"><div class="col-6 d-none d-md-block"><h1><field name="name" invisible="name == '/'" readonly="True"/></h1></div><div class="col-6 d-none d-md-block"><h1><field name="movement_name" invisible="not movement_name"/></h1></div></div></xpath><xpath expr="//field[@name='move_type']" position="after"><field name="type" groups="base.group_no_one" readonly="state != 'draft'"/><field name="is_return"/><field name="pt_arxi_inalterable_hash" groups="base.group_no_one"/><field name="pt_arxi_atcud" groups="base.group_no_one"/><field name="pt_arxi_validated_date" groups="base.group_no_one"/><field name="is_editable" invisible="1"/></xpath><xpath expr="//field[@name='move_ids']//list//field[@name='quantity']" position="attributes"><attribute name="readonly">not parent.is_editable and parent.is_return</attribute><attribute name="force_save">1</attribute></xpath><xpath expr="//sheet" position="before"><field name="transport_warning" invisible="True"/><div class="alert alert-warning mb-0" role="alert" invisible="not transport_warning"><h5>This Document is not a Transport Document</h5></div></xpath><!-- Absorbed from stock_restrictions: lock editable fields once the
