<?xml version="1.0"?>
<odoo><template id="portal_my_home_menu_transport" name="Portal layout : transport menu entries" inherit_id="portal.portal_breadcrumbs" priority="30"><xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside"><li t-if="page_name == 'transport'" t-attf-class="breadcrumb-item #{'active ' if not transport else ''}"><a t-if="transport" t-attf-href="/my/transports?{{ keep_query() }}">Transports</a><t t-else="">Transports</t></li><li t-if="transport" class="breadcrumb-item active"><t t-out="transport.name" t-if="transport.name"/><t t-else=""><em>Draft Transport</em></t></li></xpath></template><template id="portal_my_home_transport" name="Portal My Home : transport entries" inherit_id="portal.portal_my_home" priority="30"><xpath expr="//div[hasclass('o_portal_docs')]" position="inside"><t t-call="portal.portal_docs_entry"><t t-set="title">Transports</t><t t-set="url" t-value="'/my/transports'"/><t t-set="placeholder_count" t-value="'transport_count'"/></t></xpath></template><template id="portal_my_transports" name="My Transports"><t t-call="portal.portal_layout"><t t-set="breadcrumbs_searchbar" t-value="True"/><t t-call="portal.portal_searchbar"><t t-set="title">Transports</t></t><t t-if="not transports"><p>There are currently no transports for your account.</p></t><t t-if="transports" t-call="portal.portal_table"><thead><tr class="active"><th>Transport #</th><th>Transport Date</th><th class="text-end">Status</th></tr></thead><tbody><t t-foreach="transports" t-as="transport"><tr><td><a t-att-href="transport.get_portal_url()" t-att-title="transport.name"><t t-if="transport.name" t-out="transport.name"/><em t-else="">Draft Transport</em></a></td><td><span t-field="transport.date"/></td><td class="tx_status text-end"><t t-if="transport.state == 'validated'"><span class="badge badge-pill text-bg-success"><i class="fa fa-fw fa-check" aria-label="Posted" title="Posted" role="img"/><span class="d-none d-md-inline"> Posted</span></span></t><t t-if="transport.state == 'cancel'"><span class="badge badge-pill text-bg-warning"><i class="fa fa-fw fa-remove" aria-label="Cancelled" title="Cancelled" role="img"/><span class="d-none d-md-inline"> Cancelled</span></span></t></td></tr></t></tbody></t></t></template><template id="portal_transport_page" name="Transport Portal Template" inherit_id="portal.portal_sidebar" primary="True"><xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside"><t t-set="o_portal_fullwidth_alert" groups="stock.group_stock_user"><t t-call="portal.portal_back_in_edit_mode"><t t-set="backend_url" t-value="'/web#return_label=Website&amp;model=%s&amp;id=%s&amp;action=%s&amp;view_type=form' % (transport._name, transport.id, transport.env.ref('l10n_pt_stock.pt_transport_action').id)"/></t></t><div class="row mt16 o_portal_invoice_sidebar"><!-- Sidebar --><t t-call="portal.portal_record_sidebar"><t t-set="classes" t-value="'col-lg-auto d-print-none'"/><t t-set="title"><h2 class="mb-0"><b t-field="transport.name"/></h2><div class="small"/></t><t t-set="entries"><ul class="list-group list-group-flush flex-wrap flex-row flex-lg-column"><li class="list-group-item flex-grow-1"><div class="o_download_pdf btn-toolbar flex-sm-nowrap"><div class="btn-group  flex-grow-1 mr-1 mb-1"><a class="btn btn-secondary btn-block o_download_btn" t-att-href="transport.get_portal_url(report_type='pdf', download=True)" title="Download"><i class="fa fa-download"/>&amp;nbsp;Download
                                        </a></div><div class="btn-group flex-grow-1 mb-1"><a class="btn btn-secondary btn-block o_print_btn o_portal_invoice_print" t-att-href="transport.get_portal_url(report_type='pdf')" id="print_transport_report" title="Print" target="_blank"><i class="fa fa-print"/>&amp;nbspPrint
                                        </a></div></div></li><li t-if="transport.user_source_id" class="list-group-item flex-grow-1"><div class="small mb-1"><strong class="text-muted">Your Contact</strong></div><div class="row"><div class="col flex-grow-0 pr-2"><img t-if="transport.user_source_id.image_1024" class="rounded-circle mt-1 o_portal_contact_img" t-att-src="image_data_uri(transport.user_source_id.image_1024)" alt="Responsible"/><img t-else="" class="rounded-circle mt-1 o_portal_contact_img" src="/web/static/src/img/user_menu_avatar.png" alt="Responsible"/></div><div class="col pl-0"><span t-field="transport.user_source_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/><a data-toggle="modal" href="#" data-target="#transport_chatter" class="small"><i class="fa fa-fw fa-comments"/><b>Send message</b></a></div></div></li></ul></t></t><!-- Page Content --><div id="transport_content" class="col-12 col-lg"><!-- main content --><div class="o_portal_html_view shadow p-3"><div class="o_portal_html_loader text-center"><i class="fa fa-circle-o-notch fa-spin fa-2x fa-fw text-black-50"/></div><iframe id="invoice_html" class="mt8 mb8" width="100%" height="100%" frameborder="0" scrolling="no" t-att-src="transport.get_portal_url(report_type='html')"/></div><!--<div t-attf-class="card #{'pb-5' if report_type == 'html' else ''}">--><!--    <div t-call="l10n_pt_stock.transport_portal_content"/>--><!--</div>--><!-- bottom actions --><!--<div t-if="transport.state == 'validated'"--><!--     class="row justify-content-center text-center d-print-none pt-1 pb-4">--><!--    <div class="col-sm-auto mt8">--><!--        <a role="button" class="btn btn-secondary" href="#discussion">--><!--            <i class="fa fa-comment"/>--><!--            Feedback--><!--        </a>--><!--    </div>--><!--</div>--><!-- chatter --><div id="transport_communication" class="mt-4"><h2>History</h2><t t-call="portal.message_thread"/><!--<t t-set="object" t-value="transport"/>--><!--</t>--></div></div></div></xpath></template><template id="portal_transport_error" name="Transport error/warning display"><div class="row mr16"><div t-attf-class="'col-lg-12 mr16 ml16 alert alert-dismissable' #{'alert-danger' if error else 'alert-warning'}" role="alert"><a href="#" class="close" data-dismiss="alert" aria-label="close" title="close">&#xD7;</a><t t-if="error == 'generic'" name="generic">
                    There was an error processing this page.
                </t></div></div></template><template id="portal_transport_success" name="Transport success display"><div class="row mr16"><div class="col-lg-12 mr16 ml16 alert alert-dismissable alert-success" role="status"><a href="#" class="close" data-dismiss="alert" aria-label="close" title="close">&#xD7;</a></div></div></template><template id="transport_portal_content" name="Transport Portal Content"><!-- Intro --><div id="introduction" t-attf-class="pb-2 pt-3 #{'card-header bg-white' if report_type == 'html' else ''}"><h2 class="my-0"><span>Transport</span><em t-out="transport.name"/></h2></div><div t-attf-class="#{'card-body' if report_type == 'html' else ''}"><!-- Informations --><div id="informations"><div class="mb-3"><strong>Date:</strong><span t-field="transport.date" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></div><div class="mb-3" t-if="transport.at_doc_code_id"><strong>AT Document Code ID:</strong><span t-field="transport.at_doc_code_id"/></div><div class="row"><div class="col-lg-6"><address t-field="transport.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/></div></div></div><section id="details" style="page-break-inside: auto;" class="mt32"><h3 id="details">Details</h3><table class="table table-sm" id="service_transport_table"><thead class="bg-100"><tr><t t-set="colspan" t-value="2"/><th class="text-start">Products</th><th class="text-end">Quantity</th></tr></thead><tbody class="sale_tbody"><t t-foreach="transport.transport_line_ids" t-as="line"><tr><td id="product_name"><span t-field="line.name"/></td><td class="text-end"><div id="quote_qty"><span t-field="line.product_uom_qty"/><span t-field="line.product_uom" groups="uom.group_uom"/></div></td></tr></t></tbody></table></section><section id="terms" class="mt-5" t-if="transport.note"><h3 class="">Terms &amp; Conditions</h3><hr class="mt-0 mb-1"/><em t-field="transport.note"/></section></div></template></odoo>
