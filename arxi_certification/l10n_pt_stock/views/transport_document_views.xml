<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="pt_transport_view_form" model="ir.ui.view"><field name="name">pt.transport.view.form</field><field name="model">pt.transport</field><field name="arch" type="xml"><form><header><field name="return_documents" invisible="True"/><field name="allows_return_document" invisible="True"/><field name="pt_arxi_validated_date" invisible="True"/><field name="company_id" invisible="True"/><field name="foreign_partner" invisible="True"/><field name="at_doc_code_id" invisible="True"/><button name="action_cancel" invisible="state != 'validated'" type="object" string="Cancel" confirm="If the document has an AT code, cancelling it will also cancel it on the AT's end. Proceed?"/><button name="action_validate" invisible="state != 'draft'" type="object" string="Validate" class="oe_highlight"/><button name="action_at_code" type="object" string="Get AT Code" invisible="not pt_arxi_validated_date or at_doc_code_id or foreign_partner"/><button name="action_generate_returns_document" type="object" string="Generate Returns Document" invisible="not allows_return_document"/><field name="state" widget="statusbar" statusbar_visible="draft,validated"/></header><field name="qty_warning" invisible="True"/><div class="alert alert-warning mb-0" role="alert" invisible="not qty_warning"><h5>There are Lines with Quantity inferior to 0.0001.</h5></div><sheet><div class="oe_button_box" name="button_box"><button string="Customer Preview" class="oe_stat_button" type="object" name="preview_transport" icon="fa-globe" data-hotkey="o"/><button name="view_related_return_documents" type="object" class="oe_stat_button" icon="fa-file" string="Return Documents" invisible="return_documents == []"/></div><div class="oe_title"><span class="o_form_label"><field name="movement_type" readonly="True" nolabel="1"/></span><h1><field name="name" invisible="name == '/'"/><span invisible="name != '/'">Draft</span></h1><group><field name="origin_document" invisible="not origin_document"/></group><h3><group><field name="at_doc_code_id" invisible="not at_doc_code_id or foreign_partner"/></group></h3></div><group><group><field name="partner_id" string="Partner" widget="res_partner_many2one" options="{'always_reload': True}" context="{'show_address': 1, 'show_vat': True}" required="movement_type != 'own_assets.document'" invisible="movement_type == 'own_assets.document'" readonly="state != 'draft'"/></group><group><field name="date" string="Posting Date" options="{'datepicker': {'warn_future': true}}" readonly="state != 'draft'"/><label for="movement_start_date" string="Movement Date"/><div class="o_row"><field name="movement_start_date" widget="daterange" options="{'related_end_date': 'movement_end_date'}" required="state in ['comm', 'validated', 'cancelled']" readonly="at_doc_code_id"/><i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/><field name="movement_end_date" widget="daterange" options="{'related_start_date': 'movement_start_date'}" readonly="at_doc_code_id"/></div><field name="journal_id" options="{'no_create_edit': True}" string="Journal" readonly="state != 'draft'"/><field name="vehicle_id" readonly="state not in ['draft', 'comm']" string="Vehicle License Plate"/></group></group><group><group name="origin" string="Origin"><label for="loading_address_street" string="Loading Address"/><div class="o_address_format"><field name="loading_address_street" placeholder="Street..." class="o_address_street" readonly="state not in ['draft', 'comm']"/><field name="loading_address_city" placeholder="City" class="o_address_city" readonly="state not in ['draft', 'comm']"/><field name="loading_address_zip" placeholder="ZIP" class="o_address_zip" readonly="state not in ['draft', 'comm']"/><field name="loading_address_country" placeholder="Country" class="o_address_country"/></div></group><field name="hide_delivery_address" invisible="True"/><group name="destination" string="Destination" invisible="hide_delivery_address"><label for="delivery_address_street" string="Unloading Address"/><div class="o_address_format"><field name="delivery_address_street" placeholder="Street..." class="o_address_street" readonly="state not in ['draft', 'comm']"/><field name="delivery_address_city" placeholder="City" class="o_address_city" readonly="state not in ['draft', 'comm']"/><field name="delivery_address_zip" placeholder="ZIP" class="o_address_zip" readonly="state not in ['draft', 'comm']"/><field name="delivery_address_country" placeholder="Country" class="o_address_country" force_save="1"/></div></group></group><notebook><page string="Transport Lines"><field name="transport_line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="product_id"/><field name="has_tracking" invisible="True"/><field name="name"/><field name="lot_ids" widget="many2many_tags" groups="stock.group_production_lot" optional="hide" options="{'no_create_edit':True}" context="{'default_company_id': parent.company_id, 'default_product_id': product_id}" domain="[('product_id','=',product_id)]"/><field name="product_uom_qty"/><field name="allowed_uom_ids" column_invisible="True"/><field name="product_uom" groups="uom.group_uom"/></list></field><field name="note" class="oe-bordered-editor" placeholder="Terms and conditions..." readonly="state != 'draft'"/></page><page name="extra" string="Additional Info"><group><group string="Other Information" name="other_infos"><field name="user_id" widget="many2one_avatar_user" domain="[('share', '=', False)]"/><field name="movement_type" string="Movement Type"/><field name="pt_arxi_inalterable_hash" groups="base.group_no_one"/><field name="pt_arxi_atcud" groups="base.group_no_one"/></group><!-- Absorbed from print_conf_copies_pt --><group name="print_conf" string="Print Configurations"><field name="print_copies"/></group></group></page><page name="status" string="Status" groups="base.group_no_one"><group><group><field name="pt_arxi_status_id"/><field name="pt_arxi_status_date"/><field name="user_source_id"/><field name="reason" readonly="True"/></group></group></page></notebook></sheet><chatter/></form></field></record><record id="transport_documents_view_list" model="ir.ui.view"><field name="name">pt.transport.view.list</field><field name="model">pt.transport</field><field name="type">list</field><field name="arch" type="xml"><list decoration-bf="message_needaction==True" decoration-muted="state=='cancel'" decoration-info="state == 'draft'"><field name="name" string="Name"/><field name="message_needaction" invisible="True"/><field name="at_doc_code_id" string="AT Code"/><field name="journal_id" invisible="True" string="Journal"/><field name="movement_type" string="Movement Type"/><field name="partner_id" string="Partner"/><field name="movement_start_date" string="Start Date" widget="date"/><field name="movement_end_date" string="End Date" widget="date"/><field name="vehicle_id" string="Vehicle License Plate"/><field name="state"/></list></field></record><record id="transport_documents_view_search" model="ir.ui.view"><field name="name">pt.transport.view.search</field><field name="model">pt.transport</field><field name="arch" type="xml"><search string="Search"><field name="name" string="Name" filter_domain="['|',('name','ilike',self),('at_doc_code_id','=',self)]"/><field name="state"/><field name="user_source_id" string="Responsible"/><field name="date"/><field name="movement_start_date"/><field name="partner_id" string="Partner"/><field name="movement_type"/><filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/><filter name="posted" string="Posted" domain="[('state', '=', 'validated')]"/><filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancel')]"/><filter name="comm" string="Communication" domain="[('state', '=', 'comm')]"/><separator/><filter name="my_documents" string="My Transport Documents" domain="[('user_source_id', '=', uid)]"/><separator/><group><filter name="state" string="State" domain="[]" context="{'group_by':'state'}"/><filter name="posting_date" string="Posting Date" domain="[]" context="{'group_by':'date'}"/><filter name="movement_start_date" string="Movement Start Date" domain="[]" context="{'group_by':'movement_start_date'}"/><filter name="partner" string="Partner" domain="[]" context="{'group_by':'partner_id'}"/><filter name="movement_type" string="Movement Type" domain="[]" context="{'group_by':'movement_type'}"/></group></search></field></record><record id="pt_transport_action" model="ir.actions.act_window"><field name="name">Transport Documents</field><field name="type">ir.actions.act_window</field><field name="res_model">pt.transport</field><field name="view_mode">list,form</field><field name="search_view_id" ref="transport_documents_view_search"/></record><menuitem action="pt_transport_action" id="menu_action_transport_documents_list" parent="stock.menu_stock_warehouse_mgmt" sequence="200" name="Transport Documents"/></odoo>
