<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="report_delivery_document" inherit_id="stock.report_delivery_document" priority="200" primary="True"><!--Document Name--><xpath expr="//div[hasclass('page')]/h2" position="replace"><h2><span t-if="o.type == 'out_picking'">Delivery Slip</span><span t-if="o.type == 'in_picking'">Vendor Delivery Slip</span><span t-if="o.type == 'out_refund'">Return Delivery Slip</span><span t-if="o.type == 'in_refund'">Vendor Return Delivery Slip</span><span t-if="o.movement_name" t-field="o.movement_name"/><span t-else="" t-field="o.name"/></h2></xpath><xpath expr="//div[@name='div_origin']" position="after"><div t-if="o.pt_arxi_validated_date" class="col-auto" name="div_date"><strong>Date:</strong><p t-field="o.pt_arxi_validated_date" t-options="{'widget': 'date'}"/></div></xpath><xpath expr="//div[hasclass('page')]" position="after"><p t-field="o.note"/><span name="not_invoice" class="small mb-0">This document is not an invoice.</span><p t-if="o.is_pt_internal_deliverable" class="small mb-0">This document is not a Transport Document.</p></xpath></template></odoo>
