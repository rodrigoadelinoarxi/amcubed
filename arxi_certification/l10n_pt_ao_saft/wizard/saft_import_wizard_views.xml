<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="saft_import_wizard_view_form" model="ir.ui.view"><field name="name">saft.import.wizard.view.form</field><field name="model">saft.import.wizard</field><field name="arch" type="xml"><form string="SAF-T Import"><field name="state" invisible="1"/><sheet><group invisible="state != 'choose'"><field name="data"/><group><field name="force_encoding"/><field name="encoding" invisible="not force_encoding" required="force_encoding"/></group><group><field name="country_code" invisible="1"/><field name="tax_accounting_basis" invisible="country_code == 'AO'"/><field name="invoicing_legacy" invisible="tax_accounting_basis != 'F'"/></group><group string="Import Journals" invisible="tax_accounting_basis == 'C'"><field name="company_id" invisible="1"/><field name="journal_id" string="Invoice Journal" options="{'no_create_edit': True}" required="tax_accounting_basis != 'C'"/><field name="payment_journal_id" options="{'no_create_edit': True}" required="1"/></group><group string="Which data to import?"><field name="is_import_customers"/><field name="search_by_ref"/><field name="is_import_suppliers"/><field name="is_import_products" invisible="tax_accounting_basis == 'C'"/><field name="is_import_documents" invisible="tax_accounting_basis == 'C'"/><field name="is_import_balance" invisible="tax_accounting_basis == 'F'"/><field name="is_import_accounts" invisible="tax_accounting_basis == 'F'"/><field name="is_import_moves" invisible="tax_accounting_basis == 'F'"/><field name="document_batch_size"/></group></group><group invisible="state != 'get'"><field name="result" readonly="1"/></group><h3 invisible="state not in ['confirm', 'confirm_batch']">Records to Import</h3><notebook invisible="state not in ['confirm', 'confirm_batch']"><page string="Customers" name="customers"><field name="customer_ids" nolabel="1"><list create="0" delete="0" no_open="1"><field name="partner_id" invisible="1"/><field name="name"/><field name="vat"/><field name="ref"/><field name="record_to_import" widget="boolean_toggle" readonly="parent.state == 'confirm_batch'"/></list></field></page><page string="Suppliers" name="suppliers"><field name="supplier_ids" nolabel="1"><list create="0" delete="0" no_open="1"><field name="partner_id" invisible="1"/><field name="name"/><field name="vat"/><field name="ref"/><field name="record_to_import" widget="boolean_toggle" readonly="parent.state == 'confirm_batch'"/></list></field></page><page string="Products" name="products" invisible="tax_accounting_basis == 'C'"><field name="product_ids" nolabel="1"><list create="0" delete="0" no_open="1"><field name="name"/><field name="type"/><field name="default_code"/><field name="categ_id"/><field name="record_to_import" widget="boolean_toggle"/></list></field></page><page string="Invoices" name="invoices" invisible="tax_accounting_basis == 'C'"><field name="invoice_ids" nolabel="1"><list create="0" delete="0" no_open="1" editable="top"><field name="name" readonly="1"/><field name="type" readonly="1"/><field name="partner_id" readonly="1"/><field name="currency_id"/><field name="amount_total" readonly="1"/><field name="amount_paid" readonly="import_status != 'open'"/><field name="import_status" readonly="parent.invoicing_legacy"/></list></field></page><page string="Payments" name="payments"><field name="payment_ids" nolabel="1"><list create="0" delete="0" no_open="1" editable="top"><field name="name" readonly="1"/><field name="payment_date" readonly="1"/><field name="amount" digits="[10,10]" readonly="1"/><field name="amount_company_currency_signed" digits="[10,10]" readonly="1" optional="hide"/><field name="currency_id" readonly="1" optional="hide"/><field name="company_currency_id" readonly="1" optional="hide"/><field name="rate_value" digits="[10,10]" readonly="1" optional="hide"/></list></field></page><page string="Accounts" name="accounts" invisible="tax_accounting_basis == 'F'"><field name="account_ids" nolabel="1"><list create="0" delete="0" no_open="1" decoration-success="is_update_or_create == False"><field name="is_update_or_create" invisible="1"/><field name="name"/><field name="code"/><field name="group_categ" optional="hide"/><field name="record_to_import" widget="boolean_toggle" readonly="parent.is_import_moves or not is_update_or_create"/></list></field></page><page string="Journals" name="journals" invisible="tax_accounting_basis == 'F'"><field name="journal_ids" nolabel="1"><list create="0" delete="0" no_open="1" editable="bottom"><field name="journal_id" invisible="1"/><field name="name" readonly="journal_id"/><field name="code" readonly="journal_id"/></list></field></page><page string="Moves" name="moves" invisible="tax_accounting_basis == 'F'"><field name="move_ids" nolabel="1"><list create="0" delete="0" no_open="1"><field name="name"/><field name="wizard_journal_id"/><field name="record_to_import" widget="boolean_toggle"/></list></field></page></notebook></sheet><footer><button name="load_from_file" string="Next" type="object" invisible="state != 'choose'" class="oe_highlight"/><button name="prev" string="Previous" type="object" invisible="state != 'confirm'"/><button name="execute" string="Import" type="object" invisible="state not in ['confirm','confirm_batch']" class="oe_highlight"/><button special="cancel" string="Close" class="oe_highlight"/></footer></form></field></record><record id="saft_import_wizard_action" model="ir.actions.act_window"><field name="name">SAF-T Import</field><field name="res_model">saft.import.wizard</field><field name="view_mode">form</field><field name="target">new</field></record><!--Imported payments never show in the main Payments menu — they're
        linked to a self-paid (FR/FS) invoice, so is_selfpaid=True excludes
        them from account.action_account_payments's domain the same way a
        normal auto-generated self-paid receipt is excluded (UAT 42c). A
        dedicated menu, filtered on is_saft_import, is the only place to
        find them.--><record id="saft_imported_payments_action" model="ir.actions.act_window"><field name="name">Imported Payments</field><field name="res_model">account.payment</field><field name="view_mode">list,form</field><field name="domain">[('is_saft_import', '=', True)]</field></record><menuitem id="menu_saft_configuration" parent="account.menu_finance_configuration" name="Saft" sequence="15"/><menuitem id="saft_import_wizard_menu" parent="menu_saft_configuration" action="saft_import_wizard_action" name="SAF-T Import" sequence="1"/><menuitem id="saft_imported_payments_menu" parent="menu_saft_configuration" action="saft_imported_payments_action" name="Imported Payments" sequence="2"/></odoo>
