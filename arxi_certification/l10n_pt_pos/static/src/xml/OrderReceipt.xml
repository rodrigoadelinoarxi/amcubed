<?xml version="1.0"?>
<templates id="template" xml:space="preserve">

    <!-- v19: the base OrderReceipt takes the order as `props.order` (the v18
         `props.data` export dict is gone) and no longer has the
         `pos-receipt-order-data mb-2` block the v18 template replaced. The
         certified data (qr_code, pt_arxi_atcud, hash) is read straight off the
         order; the hash/ATCUD/QR logic itself is unchanged. -->
    <t t-name="l10n_pt_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="after">
            <br/>
            <div name="cert_receipt" t-if="props.order.qr_code">
            <div style="word-wrap:break-word;">ATCUD: <t t-esc="props.order.pt_arxi_atcud or '0'"/></div>
                <div id="qrcode_pt" class="mb-2">
                <img class="border border-dark rounded pos-receipt-logo" t-att-style="props.order.get_qr_style()" t-att-src="props.order.qr_code"/>
            </div>
                <div style="word-wrap:break-word;" t-if="props.order.pt_arxi_inalterable_hash"><t t-esc="props.order.pt_arxi_inalterable_hash[0] + props.order.pt_arxi_inalterable_hash[10] + props.order.pt_arxi_inalterable_hash[20] + props.order.pt_arxi_inalterable_hash[30]"/>
                    - Processed by certified
                    software no. 2790/AT</div>
            </div>
        </xpath>
    </t>

</templates>
