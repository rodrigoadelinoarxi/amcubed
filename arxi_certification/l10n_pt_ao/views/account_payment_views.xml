<?xml version="1.0" encoding="utf-8"?>
<odoo><!-- Overriding the payment action to show only payments from non-self-paid origins --><record id="account.action_account_payments" model="ir.actions.act_window"><field name="domain">[('is_selfpaid', '!=', True)]</field></record><record id="view_account_payment_form" model="ir.ui.view"><field name="name">account.payment.form.inherit.l10n_pt_ao</field><field name="model">account.payment</field><field name="inherit_id" ref="account.view_account_payment_form"/><field name="arch" type="xml"><!--Hide reset to draft button in outgoing payments--><xpath expr="//button[@name='action_draft']" position="attributes"><!--@formatter:off--><attribute name="invisible">country_code in ('PT','AO') and l10n_cert and partner_type == 'customer' or state == 'draft'</attribute><!--@formatter:on--></xpath><xpath expr="//div[hasclass('oe_title')]" position="inside"><h3><field name="payment_name" readonly="True"/><field name="l10n_cert" invisible="True"/></h3><field name="sent" invisible="True"/></xpath><xpath expr="//field[@name='date']" position="after"><field name="posting_date" options="{'datepicker': {'warn_future': true}}" readonly="state != 'draft'"/><field name="external_invoice" readonly="state != 'draft'" invisible="1"/></xpath><!-- Absorbed from print_conf_copies (Bloco C) --><xpath expr="//sheet" position="inside"><group><group string="Print Settings" name="print_conf"><field name="print_copies"/></group></group></xpath><!-- Absorbed from account_cancel_reason (Bloco C) --><xpath expr="//button[@name='action_cancel']" position="attributes"><attribute name="invisible">country_code in ('PT','AO') or state != 'draft'</attribute></xpath><xpath expr="//button[@name='action_cancel']" position="after"><button name="%(account_cancel_wizard_action_payment)d" type="action" string="Cancel" groups="account.group_account_invoice" invisible="state not in ['paid', 'in_process'] or country_code not in ('PT','AO')"/></xpath><xpath expr="//field[@name='memo']" position="after"><field name="reason" invisible="not reason"/></xpath><xpath expr="//field[@name='memo']" position="attributes"><attribute name="readonly">state != 'draft' and partner_type == 'customer' and country_code in ['PT', 'AO']</attribute></xpath><xpath expr="//group" position="after"><field name="payment_line_ids" readonly="state != 'draft' or not external_invoice"><list><field name="invoice_date" column_invisible="parent.external_invoice"/><field name="invoice_id" column_invisible="parent.external_invoice"/><field name="external_invoice_date" column_invisible="not parent.external_invoice"/><field name="external_invoice_name" column_invisible="not parent.external_invoice"/><field name="original_amount"/><field name="previous_payment"/><field name="amount"/><field name="balance"/></list></field><label for="narration"/><field name="narration" readonly="state != 'draft' and partner_type=='customer'" placeholder="Add a note..."/></xpath><xpath expr="//sheet" position="before"><field name="non_cert_warning" invisible="True"/><div class="alert alert-warning mb-0" role="alert" invisible="not non_cert_warning"><h5>You are using an Odoo Base Journal.</h5></div></xpath></field></record><record id="view_account_payment_tree" model="ir.ui.view"><field name="name">account.payment.list.inherit.l10n_pt_ao</field><field name="model">account.payment</field><field name="inherit_id" ref="account.view_account_payment_tree"/><field name="arch" type="xml"><xpath expr="//field[@name='name']" position="after"><field name="payment_name" string="Receipt Number" optional="show"/></xpath><xpath expr="//field[@name='date']" position="after"><field name="posting_date"/></xpath></field></record><record id="view_account_supplier_payment_tree" model="ir.ui.view"><field name="name">account.supplier.payment.list.inherit.l10n_pt_ao</field><field name="model">account.payment</field><field name="inherit_id" ref="account.view_account_supplier_payment_tree"/><field name="arch" type="xml"><xpath expr="//field[@name='payment_name']" position="attributes"><attribute name="optional">hide</attribute></xpath></field></record><record id="view_account_payment_register_form" model="ir.ui.view"><field name="name">account.payment.register.form.inherit.l10n_pt_ao</field><field name="model">account.payment.register</field><field name="inherit_id" ref="account.view_account_payment_register_form"/><field name="arch" type="xml"><xpath expr="//field[@name='payment_date']" position="after"><field name="posting_date" options="{'datepicker': {'warn_future': true}}"/></xpath><xpath expr="//group" position="after"><label for="note"/><field name="note" placeholder="Add a note..."/></xpath></field></record><record id="view_account_payment_line_form" model="ir.ui.view"><field name="name">l10n_pt_ao.payment.line.form</field><field name="model">l10n_pt_ao.payment.line</field><field name="arch" type="xml"><form><group><group name="payment_group"><field name="payment_id"/><field name="original_amount"/><field name="previous_payment"/><field name="amount"/><field name="balance"/><field name="payment_currency_id" invisible="1"/></group><group name="invoice_group"><field name="invoice_id" invisible="parent.external_invoice"/><field name="invoice_date" invisible="parent.external_invoice"/><field name="external_invoice_name" invisible="not parent.external_invoice"/><field name="external_invoice_date" invisible="not parent.external_invoice"/><field name="amount_company"/><field name="company_currency_id" invisible="1"/></group></group></form></field></record><record id="view_account_payment_search" model="ir.ui.view"><field name="name">account.payment.search.inherit.l10n_pt_ao</field><field name="model">account.payment</field><field name="inherit_id" ref="account.view_account_payment_search"/><field name="arch" type="xml"><xpath expr="//field[@name='name']" position="attributes"><attribute name="filter_domain">
                    ['|', '|', '|', '|', '|', ('name', 'ilike', self), ('payment_name', 'ilike', self), ('partner_id',
                    'ilike', self),
                    ('memo', 'ilike', self), ('amount_company_currency_signed', 'ilike', self),
                    ('amount', 'ilike', self)]
                </attribute></xpath></field></record></odoo>
