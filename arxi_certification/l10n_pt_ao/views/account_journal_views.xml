<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="view_account_journal_form" model="ir.ui.view"><field name="name">account.journal.form.inherit.document_status</field><field name="model">account.journal</field><field name="inherit_id" ref="account.view_account_journal_form"/><field name="arch" type="xml"><xpath expr="//field[@name='payment_provider_id']" position="before"><field name="code" invisible="True"/></xpath><xpath expr="//field[@name='restrict_mode_hash_table']" position="after"><field name="country_code" invisible="True"/><field name="l10n_cert" invisible="country_code not in ['PT', 'AO']"/><field name="self_billing_partner" groups="l10n_pt_ao.group_show_selfbilling_invoices" options="{'no_create': True}" invisible="type != 'purchase' or not l10n_cert" required="type == 'purchase' and l10n_cert"/></xpath><xpath expr="//field[@name='type']" position="after"><field name="source_billing"/></xpath><xpath expr="//field[@name='inbound_payment_method_line_ids']/list/field[@name='name']" position="after"><field name="is_payment_mechanism_required" invisible="True"/><field name="payment_mechanism_id" optional="show" required="is_payment_mechanism_required"/></xpath><xpath expr="//field[@name='outbound_payment_method_line_ids']/list/field[@name='name']" position="after"><field name="payment_mechanism_id" optional="show"/></xpath><xpath expr="//page[@name='advanced_settings']/group" position="inside"><group string="Journal Type" invisible="type not in ('sale', 'purchase')"><field name="country_id" invisible="True"/><field name="document_type_id" options="{&quot;no_open&quot;: True,&quot;no_create_edit&quot;: True}" widget="radio"/></group></xpath><xpath expr="//field[@name='restrict_mode_hash_table']" position="attributes"><attribute name="invisible"/></xpath><!-- Native v19 per-partner self-billing sequences conflict with AT series
                 numbering: hidden on certified journals (see _check_native_self_billing_vs_certified) --><xpath expr="//field[@name='is_self_billing']" position="attributes"><attribute name="invisible">type != 'purchase' or l10n_cert</attribute></xpath></field></record><record id="view_account_journal_search_inherit" model="ir.ui.view"><field name="name">account.journal.search.inherit</field><field name="model">account.journal</field><field name="inherit_id" ref="account.view_account_journal_search"/><field name="arch" type="xml"><xpath expr="//filter[@name='miscellaneous']" position="after"><filter name="self_billing" string="Self-Billing" domain="[('self_billing_partner', '!=', False)]"/></xpath></field></record></odoo>
