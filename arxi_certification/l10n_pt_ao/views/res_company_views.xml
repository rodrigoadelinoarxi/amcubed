<?xml version="1.0" encoding="utf-8"?>
<odoo><!-- Company View Modifications --><record id="view_company_form" model="ir.ui.view"><field name="name">res.company.form.inherit.l10n_pt_ao</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><!--Adds portuguese required fields--><xpath expr="//field[@name='email']" position="after">
            </xpath><xpath expr="//field[@name='vat']" position="attributes"><attribute name="readonly">parent_id and country_code in ['PT', 'AO']</attribute><attribute name="required">country_code in ['PT', 'AO']</attribute></xpath><xpath expr="//field[@name='company_registry']" position="attributes"><attribute name="readonly">parent_id and country_code in ['PT', 'AO']</attribute><attribute name="required">country_code in ['PT', 'AO']</attribute></xpath><!--Portuguese/Angolan companies must have a complete address (UAT 1)--><xpath expr="//field[@name='street']" position="attributes"><attribute name="required">country_code in ['PT', 'AO']</attribute></xpath><xpath expr="//field[@name='city']" position="attributes"><attribute name="required">country_code in ['PT', 'AO']</attribute></xpath><xpath expr="//field[@name='zip']" position="attributes"><attribute name="required">country_code in ['PT', 'AO']</attribute></xpath><!-- Absorbed from print_conf_copies (Bloco C) --><xpath expr="//group" position="after"><group string="Print Configuration"><field name="print_conf_type"/><field name="default_print_copies" invisible="print_conf_type != 'contacts'"/></group><field name="print_conf_ids" invisible="print_conf_type != 'docs'" options="{'no_create_edit': False}"><list editable="bottom"><field name="doc_type"/><field name="print_copies_conf"/></list></field></xpath></field></record></odoo>
