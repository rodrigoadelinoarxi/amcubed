und') and not pt_arxi_is_self_billing</attribute><attribute name="readonly">state != 'draft'</attribute><attribute name="invisible">move_type not in ('in_invoice', 'in_receipt', 'in_refund') or pt_arxi_is_self_billing</attribute></xpath><xpath expr="//label[@for='ref']" position="attributes"><attribute name="invisible">move_type not in ('in_invoice', 'in_receipt', 'in_refund') or pt_arxi_is_self_billing</attribute></xpath><xpath expr="//group[@name='sale_info_group']/field[@name='ref']" position="attributes"><attribute name="readonly">state != 'draft' and l10n_cert</attribute></xpath><xpath expr="//page[@name='other_info']" position="after"><page string="Status" name="status" groups="base.group_no_one"><group><group><field name="pt_arxi_status_id"/><field name="pt_arxi_status_date"/><field name="user_source_id"/></group><group><field name="reason"/></group></group></page></xpath><xpath expr="//group[@name='sale_info_group']" position="inside"><field name="is_proof_delivery" groups="account.group_delivery_invoice_address" readonly="state != 'draft'"/></xpath><xpath expr="//sheet" position="before"><field name="line_warning" invisible="True"/><field name="non_cert_warning" invisible="True"/><div class="alert alert-warning mb-0" role="alert" invisible="not line_warning"><h5>A Line Description was shortened to 200 characters.</h5></div><div class="alert alert-warning mb-0" role="alert" invisible="not non_cert_warning"><h5>You are using an Odoo Base Journal.</h5></div></xpath><xpath expr="//field[@name='journal_id']" position="attributes"><attribute name="domain">[('id', 'in', suitable_journal_ids)]</attribute></xpath><!-- Absorbed from invoice_shipping_info (Bloco C) --><xpath expr="//page[@name='other_info']" position="after"><page string="Shipping" name="shipping_page" groups="account.group_delivery_invoice_address" invisible="move_type not in ('out_invoice', 'out_refund') or not is_proof_delivery"><group><group name="addresses_info" string="Addresses" groups="account