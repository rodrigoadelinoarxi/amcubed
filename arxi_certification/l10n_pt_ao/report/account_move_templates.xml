<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="report_custom_invoice_document" inherit_id="account.report_invoice_document" priority="100"><xpath expr="//td[@name='account_invoice_line_name']/span" position="replace"><t t-if="o.country_code in ['PT', 'AO']"><span t-out="'[%s] %s' % (line.product_id.default_code, line.product_id.name)" t-options="{'widget': 'text'}"/></t><t t-else=""><span t-field="line.name" t-options="{'widget': 'text'}"/></t></xpath><xpath expr="//div[@name='comment']" position="attributes"><attribute name="t-if">not is_html_empty(o.narration) and not o.needs_separate_comment_report</attribute></xpath><xpath expr="//div[@name='comment']" position="replace"><t t-if="o.narration and not o.needs_separate_comment_report"><div name="comment" style="padding-top: 40px;"><span t-field="o.narration"/></div></t></xpath><xpath expr="//t[@t-set='information_block']" position="attributes"><attribute name="t-if">not o.is_proof_delivery</attribute></xpath><xpath expr="//div[hasclass('oe_structure')]/parent::div" position="inside"><br/><!--Loading address--><div class="row" t-if="o.is_proof_delivery" style="page-break-inside: avoid;"><div name="loading_address" t-out="loading_address" class="col-6 mt96"><strong>Loading Address:</strong><div class="d-flex align-items-baseline"><span class="w-100 o_force_ltr d-block" itemprop="streetAddress"><span t-out="o.loading_address_street"/><span t-out="o.loading_address_street2"/></span></div><div class="d-flex align-items-baseline"><span class="o_force_ltr"><div><span t-out="o.loading_address_city"/><span t-out="o.loading_address_state_id.code"/><span t-out="o.loading_address_zip"/></div></span></div><div class="d-flex align-items-baseline"><span class="o_force_ltr" t-out="o.loading_address_country_id.name"/></div></div><div name="shipping_address" t-if="o.document_shipping_address_id or o.document_commercial_address_id" t-out="shipping_address" class="col-6 mt96"><div t-if="o.document_commercial_address_id"><strong>Company address:</strong><div t-field="o.document_commercial_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/></div><div t-if="o.document_shipping_address_id" groups="account.group_delivery_invoice_address"><strong>Shipping address:</strong><div t-field="o.document_shipping_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;], &quot;no_marker&quot;: True}"/></div></div></div></xpath><xpath expr="//t[@t-set='layout_document_title']" position="after"><t t-call="l10n_pt_ao.report_staging_warning" t-lang="lang"/></xpath><!-- Absorbed from print_conf_copies (Bloco C): Original/Duplicate label --><xpath expr="//t[@t-set='layout_document_title']" position="after"><t t-if="o.country_code in ['PT', 'AO']"><t t-call="l10n_pt_ao.print_copies_display" t-lang="lang"/></t></xpath><!-- Absorbed from invoice_shipping_info (Bloco C): tax point date + shipping fields --><xpath expr="//div[hasclass('page')]" position="inside"><!--tax point date--><div t-if="o.move_type == 'out_invoice' and o.tax_point_date and o.company_id.country_id.code in ['PT', 'AO']" class="small" name="goods_available"><t t-set="o_tz" t-value="o.with_context(tz='Europe/Lisbon') if o.company_id.country_id.code == 'PT' else o"/><span>
                    Goods and/or services sent or made available to the purchaser at
                    <span t-field="o_tz.tax_point_date"/>
                    (art. 36th, n. 5, paragraph f of CIVA).
                </span></div><!--Shipping fields--><div t-if="o.show_shipping_info" name="expedition" class="row"><div class="col-4" t-if="o.gross_weight" name="gross_weight"><strong>Gross Weight:&amp;nbsp;</strong><span t-field="o.gross_weight"/><span t-field="o.weight_uom"/></div><div class="col-4" t-if="o.net_weight" name="net_weight"><strong>Net Weight:&amp;nbsp;</strong><span t-field="o.net_weight"/><span t-field="o.weight_uom"/></div><div class="col-4" t-if="o.number_of_parcels" name="number_of_parcels"><strong>Number of Parcels:&amp;nbsp;</strong><span t-field="o.number_of_parcels"/></div></div></xpath><xpath expr="//div[hasclass('oe_structure')]/parent::div" position="inside"><t t-if="o_tz and o.is_proof_delivery"><div style="page-break-inside: avoid;"><br/><strong>Shipping Departure Date:</strong><span t-field="o_tz.shipping_departure_date"/><br/></div></t></xpath><xpath expr="//div[hasclass('page')]" position="after"><t t-if="not is_html_empty(o.narration) and o.needs_separate_comment_report"><t t-call="l10n_pt_ao.report_terms_and_conditions" t-lang="lang"/></t></xpath><!-- Absorbed from account_cancel_reason (Bloco C): reason on credit
             notes and cancelled documents --><xpath expr="//div[@id='informations']" position="after"><p t-if="o.move_type == 'out_refund' or o.state == 'cancel'">Reason:
                <span t-field="o.reason"/>
            </p></xpath></template><template id="report_terms_and_conditions"><t t-set="o" t-value="o.with_context(lang=lang)"/><div class="page" style="page-break-before: always;"><div class="mt32"><p class="fake_h3 mb-0">Terms &amp; Conditions</p><hr class="mt-0 mb-1"/><span name="comment" t-field="o.narration"/></div></div></template><template id="report_invoice" inherit_id="account.report_invoice" priority="101"><!-- Remove base t-call to template to be replaced by the foreach statement.
             Merged with the print_conf_copies wrapper (Bloco C): renders one copy
             per configured print_copies on certified journals, labelled via print_type. --><xpath expr="//t[@t-call='account.report_invoice_document']" position="replace"><t t-set="copies" t-value="report_type != 'html' and o.journal_id.l10n_cert and int(o.print_copies) or 1"/><t t-foreach="range(1, copies + 1)" t-as="i"><t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'" t-call="account.report_invoice_document" t-lang="o.partner_id.lang"><t t-set="print_type" t-value="i"/></t></t></xpath></template></odoo>
