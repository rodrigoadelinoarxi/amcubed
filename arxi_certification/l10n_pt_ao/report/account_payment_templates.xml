<?xml version="1.0" encoding="utf-8"?>
<odoo><!-- Absorbed from print_conf_copies (Bloco C): one copy per configured print_copies --><template id="report_payment_receipt" inherit_id="account.report_payment_receipt" priority="10"><xpath expr="//t[@t-call='account.report_payment_receipt_document']" position="replace"><t t-set="copies" t-value="int(o.print_copies)"/><t t-foreach="range(1, copies + 1)" t-as="print_type"><t t-call="account.report_payment_receipt_document" t-lang="lang"/></t></xpath></template><template id="report_payment_inherit" inherit_id="account.report_payment_receipt_document"><!-- Absorbed from print_conf_copies (Bloco C): Original/Duplicate label --><xpath expr="//div[@t-if='o.date']/../.." position="before"><t t-if="o.country_code in ['PT', 'AO']"><t t-call="l10n_pt_ao.print_copies_display" t-lang="lang"/></t></xpath><!-- Absorbed from account_cancel_reason (Bloco C): reason on cancelled payments --><xpath expr="//div[hasclass('page')]/h3" position="after"><p t-if="o.state == 'canceled'">Reason: <span t-field="o.reason"/></p></xpath><!--        Add static address--><xpath expr="//span[@t-field='o.partner_id']" position="replace"><span t-if="o.document_address_id" t-field="o.document_address_id"/><span t-else="" t-field="o.partner_id"/></xpath><!--        Title depending on payment type--><xpath expr="//h3/strong" position="replace"><strong><h2><t t-if="o.payment_type == 'outbound'">Payment </t><t t-if="o.payment_type == 'inbound'">Receipt </t><t t-if="o.payment_type == 'transfer'">Transfer </t><span t-if="o.payment_name" t-field="o.payment_name"/> 
                    <span t-else="" t-field="o.name"/>
                </h2></strong></xpath><!--Disable old fields for partner and total amount--><xpath expr="//div[@t-if='o.partner_type']" position="replace"/><xpath expr="//div[@t-if='o.amount']" position="replace"/><!--Add partner address to the document--><xpath expr="//div[hasclass('page')]" position="before"><div name="payment_partner_address" class="row justify-content-between"><t t-if="o.country_code in ['PT', 'AO']"><t t-set="address" t-if="o.document_address_id and o.payment_type == 'inbound' and o.partner_type == 'customer'"><div class="col-6"><address t-field="o.document_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/><div t-if="o.document_address_id.vat" class="mt16"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>:
                                <span t-field="o.document_address_id.vat"/></div></div></t><t t-set="address" t-elif="o.partner_id"><div class="col-6"><address t-field="o.partner_id.commercial_partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/><div t-if="o.partner_id.commercial_partner_id.vat" class="mt16"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>:
                                <span t-field="o.partner_id.commercial_partner_id.vat"/></div></div></t></t><t t-else=""><t t-set="address" t-if="o.partner_id"><div class="col-6"><address t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/><div t-if="o.partner_id.vat" class="mt16"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>:
                                <span t-field="o.partner_id.vat"/></div></div></t></t></div></xpath><!--Show transaction date--><xpath expr="//div[@t-if='o.date']" position="replace"><div class="col-6" t-if="o.posting_date">
                Posting Date:
                <span t-field="o.posting_date"/>
            </div></xpath><xpath expr="//table[hasclass('table','table-borderless')]" position="before"><t t-if="o.state == 'canceled'"><p class="diagonal-text cancelled">Cancelled</p></t><t t-call="l10n_pt_ao.report_staging_warning" t-lang="lang"/></xpath><!--Table with payment lines instead of invoices--><xpath expr="//table[hasclass('table','table-borderless')]" position="attributes"><attribute name="t-if">o.partner_type == 'supplier'</attribute></xpath><xpath expr="//table[hasclass('table','table-borderless')]" position="before"><table class="table table-sm" t-if="o.partner_type == 'customer'"><thead><tr><th>Invoice Date</th><th>Invoice Number</th><th class="text-right">Original Amount</th><th class="text-right">Previous Receipt</th><th class="text-right">Amount Paid</th><th class="text-right">Balance</th></tr></thead><tbody><tr t-foreach="o.payment_line_ids" t-as="line"><td><span t-field="line.invoice_date"/></td><td><span t-field="line.invoice_id.name"/></td><td class="text-right"><span t-field="line.original_amount"/></td><td class="text-right"><span t-field="line.previous_payment"/></td><td class="text-right"><span t-field="line.amount"/></td><td class="text-right"><span t-field="line.balance"/></td></tr></tbody></table></xpath><!--Total section--><xpath expr="//table[hasclass('table','table-borderless')]" position="after"><t t-set="tax_groups" t-value="o.get_tax_groups_summary()"/><div class="clearfix"><div id="total" class="row"><div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ml-auto"><table class="table table-sm"><t t-if="o.company_id.show_payment_tax_details and o.invoice_ids"><tr class="o_subtotal"><td><span>Subtotal (without tax)</span></td><td class="text-right"><span t-esc="o.get_subtotal_before_tax()" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td></tr><t t-foreach="tax_groups" t-as="tax_group"><tr><td><span t-esc="tax_group['name']"/></td><td class="text-right"><span t-esc="tax_group['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td></tr></t></t><t t-if="o.discount"><tr class="border-black o_subtotal" style=""><td><strong>Subtotal</strong></td><td class="text-right"><strong t-field="o.amount_subtotal"/></td></tr><tr style=""><td><t t-if="o.discount &gt;= 0"><strong>Discount</strong></t><t t-else=""><strong>Advance</strong></t></td><td class="text-right o_price_total"><span t-esc="abs(o.discount)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td></tr></t><tr class="border-black o_total" id="total_row"><td><strong>Total</strong></td><td class="text-right"><strong t-field="o.amount"/></td></tr><t t-if="o.company_currency_id != o.currency_id and o.country_code != 'AO'"><tr class="border-black o_total"><td><strong>Total (<span t-field="o.company_currency_id.name"/>)
                                        </strong></td><td class="text-right"><strong t-field="o.amount_company"/></td></tr></t></table></div></div></div></xpath><xpath expr="//div[hasclass('page')]" position="after"><p t-field="o.narration"/><t t-if="o.country_code in ['PT', 'AO']"><p name="not_invoice">This document is not an invoice.</p></t></xpath></template><record id="account.action_report_payment_receipt" model="ir.actions.report"><field name="print_report_name">(object._get_report_base_filename())</field></record></odoo>
