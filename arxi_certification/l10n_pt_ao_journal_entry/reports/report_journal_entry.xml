<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="report_journal_entry_document"><t t-call="web.external_layout"><t t-set="o" t-value="doc.with_context(lang=lang)"/><div class="page"><h2><span>Journal Entry</span><span t-field="o.name"/></h2><div id="informations" class="row mt32 mb32"><div class="col mw-100 mb-2 text-wrap" t-if="o.journal_id" name="journal"><strong>Journal:</strong><p class="m-0" t-field="o.journal_id"/></div><div class="col mw-100 mb-2 text-wrap" t-if="o.ref" name="reference"><strong>Reference:</strong><p class="m-0" t-field="o.ref"/></div><div class="col mw-100 mb-2 text-wrap" t-if="o.date" name="date"><strong>Date:</strong><p class="m-0" t-field="o.date"/></div></div><table class="table table-sm o_main_table"><thead><tr><th class="text-left">Account</th><th groups="analytic.group_analytic_accounting">Analytic Account</th><th class="text-left">Partner</th><th class="text-left">Label</th><th class="text-right">Debit</th><th class="text-right">Credit</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="line"><td><span t-field="line.account_id"/></td><td groups="analytic.group_analytic_accounting"><span t-esc="line._get_analytic_account_name()"/></td><td><span t-field="line.partner_id"/></td><td><span t-field="line.name"/></td><td class="text-right"><span t-field="line.debit"/></td><td class="text-right"><span t-field="line.credit"/></td></tr></tbody><tfoot><tr class="border-black o_total"><td/><td groups="analytic.group_analytic_accounting"/><td/><td><strong>Total</strong></td><td class="py-2 text-right"><span t-field="o.amount_total"/></td><td class="py-2 text-right"><span t-field="o.amount_total"/></td></tr></tfoot></table><p t-if="o.narration" name="narration"><span t-field="o.narration"/></p></div></t></template><template id="report_journal_entry"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="l10n_pt_ao_journal_entry.report_journal_entry_document"/></t></t></template><record id="action_report_journal_entry" model="ir.actions.report"><field name="name">Journal Entry</field><field name="model">account.move</field><field name="report_type">qweb-pdf</field><field name="report_name">l10n_pt_ao_journal_entry.report_journal_entry</field><field name="report_file">l10n_pt_ao_journal_entry.report_journal_entry</field><field name="print_report_name">'Journal Entry - %s' % (object.name)</field><field name="attachment"/><field name="binding_model_id" ref="model_account_move"/><field name="binding_type">report</field></record><record id="view_move_form" model="ir.ui.view"><field name="name">account.move.form.inherit.journal_entry_report</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><button name="action_post" position="after"><button name="action_print_journal_entry" string="Print" invisible="move_type != 'entry'" type="object"/></button></field></record></odoo>
