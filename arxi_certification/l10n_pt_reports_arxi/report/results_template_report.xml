<?xml version="1.0"?>
<odoo><!-- Results Template Report --><record id="results_template_report" model="ir.actions.report"><field name="name">Results Template Report</field><field name="model">account.report</field><field name="report_type">qweb-pdf</field><field name="report_name">l10n_pt_reports_arxi.results_template</field><field name="report_file">l10n_pt_reports_arxi.results_template</field><field name="binding_model_id" ref="account.model_account_report"/><field name="binding_type">report</field></record><template id="results_template"><t t-call="web.html_container"><t t-call="web.external_layout"><div class="page"><h3><t t-esc="data.get('report_title', 'Trial Balance')"/></h3><table id="informations" class="table table-borderless mt32 mb32" style="width: 100%;"><tr><td t-if="data.get('date_from')" name="date_from" style="width: 50%; padding-right: 2rem; vertical-align: top;"><strong>Data In&#xED;cio:</strong><div t-esc="data.get('date_from')"/></td><td t-if="data.get('date_to')" name="date_to" style="width: 50%; padding-left: 2rem; vertical-align: top;"><strong>Data Fim:</strong><div t-esc="data.get('date_to')"/></td></tr></table><table class="table table-sm"><thead><tr><th class="text-left">Code</th><th class="text-left">Name</th><th class="text-right">Debit</th><th class="text-right">Credit</th><th class="text-right">Monthly Debit</th><th class="text-right">Monthly Credit</th><th class="text-right">Debit Balance</th><th class="text-right">Credit Balance</th></tr></thead><tbody><tr t-foreach="data.get('lines', [])" t-as="line"><td class="text-left"><span><t t-esc="line.get('code')"/></span></td><td class="text-left"><span><t t-esc="line.get('name')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(float(line.get('debit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(float(line.get('credit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(float(line.get('debit_month', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(float(line.get('credit_month', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(abs(float(line.get('debit_balance', 0)))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(float(line.get('credit_balance', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td></tr></tbody><tfoot><tr class="border-black o_total"><td/><td/><td class="py-2 text-right"><span t-esc="'{:,}'.format(float(data.get('total_debit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td><td class="py-2 text-right"><span t-esc="'{:,}'.format(float(data.get('total_credit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td><td class="py-2 text-right"><span t-esc="'{:,}'.format(float(data.get('total_debit_month', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td><td class="py-2 text-right"><span t-esc="'{:,}'.format(float(data.get('total_credit_month', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td><td class="py-2 text-right"><span t-esc="'{:,}'.format(abs(float(data.get('total_debit_balance', 0)))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td><td class="py-2 text-right"><span t-esc="'{:,}'.format(float(data.get('total_credit_balance', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td></tr></tfoot></table></div></t></t></template></odoo>
