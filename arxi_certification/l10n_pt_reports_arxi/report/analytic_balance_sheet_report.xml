<?xml version="1.0"?>
<odoo><!-- Analytic Balance Sheet Report --><record id="analytic_balance_sheet_report" model="ir.actions.report"><field name="name">Analytic Balance Sheet Report</field><field name="model">account.analytic.balance.report.handler</field><field name="report_type">qweb-pdf</field><field name="report_name">l10n_pt_reports_arxi.analytic_balance_sheet_template</field><field name="report_file">l10n_pt_reports_arxi.analytic_balance_sheet_template</field><field name="binding_model_id" ref="model_account_analytic_balance_report_handler"/><field name="binding_type">report</field></record><template id="analytic_balance_sheet_template"><t t-call="web.html_container"><t t-call="web.external_layout"><div class="page"><h3><t t-esc="data.get('report_title', 'Trial Balance')"/></h3><table id="informations" class="table table-borderless mt32 mb32" style="width: 100%;"><tr><td t-if="data.get('date_from')" name="date_from" style="width: 50%; padding-right: 2rem; vertical-align: top;"><strong>Data In&#xED;cio:</strong><div t-esc="data.get('date_from')"/></td><td t-if="data.get('date_to')" name="date_to" style="width: 50%; padding-left: 2rem; vertical-align: top;"><strong>Data Fim:</strong><div t-esc="data.get('date_to')"/></td></tr></table><table class="table table-sm"><thead><tr><th class="text-left" rowspan="2"><span>C&#xF3;digo</span></th><th class="text-left" rowspan="2"><span>Account Name</span></th><th class="text-center" colspan="2"><span>Opening Balance (Accumulated)</span></th><th class="text-center" colspan="2"><span t-esc="data.get('period_label') or data.get('date_to', '')[:4]"/></th><th class="text-center" colspan="2"><span>Total (Final Balance)</span></th></tr><tr><th class="text-right"><span>D&#xE9;bito</span></th><th class="text-right"><span>Cr&#xE9;dito</span></th><th class="text-right"><span>D&#xE9;bito</span></th><th class="text-right"><span>Cr&#xE9;dito</span></th><th class="text-right"><span>D&#xE9;bito</span></th><th class="text-right"><span>Cr&#xE9;dito</span></th></tr></thead><tbody><tr t-foreach="data.get('lines', [])" t-as="line"><td class="text-left"><span><t t-esc="line.get('code')"/></span></td><td class="text-left"><span><t t-esc="line.get('name')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(float(line.get('debit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(float(line.get('credit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(float(line.get('period_debit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(float(line.get('period_credit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(float(line.get('debit_balance', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td><td class="text-right"><span><t t-esc="'{:,}'.format(float(line.get('credit_balance', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></span></td></tr></tbody><tfoot><tr class="border-black o_total"><td/><td/><td class="py-2 text-right"><span t-esc="'{:,}'.format(float(data.get('total_debit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td><td class="py-2 text-right"><span t-esc="'{:,}'.format(float(data.get('total_credit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td><td class="py-2 text-right"><span t-esc="'{:,}'.format(float(data.get('total_period_debit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td><td class="py-2 text-right"><span t-esc="'{:,}'.format(float(data.get('total_period_credit', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td><td class="py-2 text-right"><span t-esc="'{:,}'.format(float(data.get('total_debit_balance', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td><td class="py-2 text-right"><span t-esc="'{:,}'.format(float(data.get('total_credit_balance', 0))).replace(',', 'X').replace('.', ',').replace('X', '.')"/><t t-esc="data.get('currency')"/></td></tr></tfoot></table></div></t></t></template></odoo>
