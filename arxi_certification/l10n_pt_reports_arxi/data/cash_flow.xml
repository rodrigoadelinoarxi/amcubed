                </field><field name="children_ids"><record id="cash_flow_statement_fa_receipts_from" model="account.report.line"><field name="name">Receipts from:</field><field name="code">FA_RECEIPTS_FROM</field><field name="children_ids"><record id="cash_flow_statement_fa_obtained_financing" model="account.report.line"><field name="name">Obtained Financing</field><field name="code">OBTAINED_FINANCING</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="expression_ids"><record id="cash_flow_statement_fa_obtained_financing_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('debit', '&gt;', 0.0), '|',('account_id.code', '=ilike', '11%'), ('account_id.code', '=ilike', '12%'),('tax_tag_ids', '=', ref('l10n_pt_reports_arxi.account_tag_financing')),('journal_id.type','in',('bank','cash','general'))]"/><field name="subformula">sum</field></record></field></record><record id="cash_flow_statement_fa_capital_subscriptions" model="account.report.line"><field name="name">Capital Subscriptions and Other Equity Instruments</field><field name="code">CAPITAL_SUBSCRIPTIONS</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="expression_ids"><record id="cash_flow_statement_fa_capital_subscriptions_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('debit', '&gt;', 0.0), '|',('account_id.code', '=ilike', '11%'), ('account_id.code', '=ilike', '12%'),('tax_tag_ids', '=', ref('l10n_pt_reports_arxi.account_tag_capital')),('journal_id.type','in',('bank','cash','general'))]"/><field name="subformula">sum</field></record></field></record><record id="cash_flow_statement_fa_loss_coverage" model="account.report.line"><field name="name">Coverage of Losses</field><field name="code">LOSS_COVERAGE</field><field name="groupby">move_id</field><fi