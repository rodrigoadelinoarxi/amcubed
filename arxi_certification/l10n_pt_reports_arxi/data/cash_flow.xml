<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="cash_flow_statement" model="account.report"><field name="name">Cash Flow Statement</field><field name="filter_period_comparison" eval="True"/><field name="root_report_id" ref="account_reports.cash_flow_report"/><field name="country_id" ref="base.pt"/><field name="column_ids"><!--<record id="cash_flow_statement_initial_balance" model="account.report.column">--><!--    <field name="name">Initial Balance</field>--><!--    <field name="expression_label">initial_balance</field>--><!--</record>--><record id="cash_flow_statement_balance" model="account.report.column"><field name="name">Balance</field><field name="expression_label">balance</field></record></field><field name="line_ids"><record id="cash_flow_statement_direct_method" model="account.report.line"><field name="name">Fluxos de caixa das actividades operacionais - método directo (1)</field><field name="code">OPERATING_ACTIVITIES</field><field name="hierarchy_level">1</field><field name="aggregation_formula">CASH_OPERATIONS.balance + INCOME_TAX_PAYMENT.balance +
                    OTHER_PAYMENTS.balance
                </field><field name="children_ids"><record id="cash_flow_statement_cash_operations" model="account.report.line"><field name="name">Cash generated by operations</field><field name="code">CASH_OPERATIONS</field><field name="hierarchy_level">2</field><field name="aggregation_formula">ACCOUNT_RECEIVABLES.balance + SUPPLIER_PAYMENTS.balance +
                            EMPLOYEE_PAYMENTS.balance
                        </field><field name="children_ids"><record id="cash_flow_statement_account_receivables" model="account.report.line"><field name="name">Account Receivables</field><field name="code">ACCOUNT_RECEIVABLES</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="domain_formula">-sum([('credit', '&gt;', 0.0), ('account_id.code','=ilike', '21%'),('journal_id.type','in',('bank','cash', 'general'))])
                                </field><field name="hierarchy_level">3</field></record><record id="cash_flow_statement_supplier_payments" model="account.report.line"><field name="name">Payments to Suppliers</field><field name="code">SUPPLIER_PAYMENTS</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="domain_formula">-sum([('debit', '&gt;', 0.0), ('account_id.code', '=ilike','22%'),('journal_id.type','in',('bank','cash', 'general'))])
                                </field><field name="hierarchy_level">3</field></record><record id="cash_flow_statement_employee_payments" model="account.report.line"><field name="name">Payments to Employees</field><field name="code">EMPLOYEE_PAYMENTS</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="domain_formula">-sum([('debit', '&gt;', 0.0), ('account_id.code', '=ilike','23%'),('journal_id.type','in',('bank','cash','general'))])
                                </field><field name="hierarchy_level">3</field></record></field></record><record id="cash_flow_statement_income_tax_payment" model="account.report.line"><field name="name">Income Tax Payment</field><field name="code">INCOME_TAX_PAYMENT</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="domain_formula">-sum([('account_id.code', '=ilike','2415%'),('journal_id.type','in',('bank','cash','general'))])
                        </field><field name="hierarchy_level">3</field></record><record id="cash_flow_statement_other_payments" model="account.report.line"><field name="name">Other Payments</field><field name="code">OTHER_PAYMENTS</field><field name="hierarchy_level">3</field><field name="expression_ids"><record id="cash_flow_statement_other_payments_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">external</field><field name="formula">sum</field><field name="subformula">editable;rounding=2</field></record></field></record></field></record><record id="cash_flow_statement_investment_activities" model="account.report.line"><field name="name">Fluxos de caixa das actividades de investimento (2)</field><field name="code">INVESTMENT_ACTIVITIES</field><field name="aggregation_formula"/><field name="hierarchy_level">1</field><field name="aggregation_formula">FIXED_ASSETS.balance + INTANGIBLE_ASSETS.balance +
                    FINANCIAL_INVESTMENTS.balance + OTHER_ASSETS.balance + RF_FIXED_ASSETS.balance +
                    RF_INTANGIBLE_ASSETS.balance + RF_FINANCIAL_INVESTMENTS.balance + RF_OTHER_ASSETS.balance +
                    INVESTMENT_SUBSIDIES.balance + INTEREST_SIMILAR_EARNINGS.balance + DIVIDENDS.balance
                </field><field name="children_ids"><record id="cash_flow_statement_ia_payments_for" model="account.report.line"><field name="name">Payments for:</field><field name="code">IA_PAYMENTS_FOR</field><field name="children_ids"><record id="cash_flow_statement_fixed_assets" model="account.report.line"><field name="name">Fixed Assets</field><field name="code">FIXED_ASSETS</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="expression_ids"><record id="cash_flow_statement_fixed_assets_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('credit', '&gt;', 0.0), '|', ('account_id.code', '=ilike', '11%'), ('account_id.code', '=ilike', '12%'), ('tax_tag_ids', '=', ref('l10n_pt_reports_arxi.account_tag_fixed_assets')), ('journal_id.type', 'in', ('bank', 'cash', 'general'))]"/><field name="subformula">sum</field></record></field></record><record id="cash_flow_statement_intangible_assets" model="account.report.line"><field name="name">Intangible Assets</field><field name="code">INTANGIBLE_ASSETS</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="expression_ids"><record id="cash_flow_statement_intangible_assets_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('credit', '&gt;', 0.0), '|', ('account_id.code', '=ilike', '11%'), ('account_id.code', '=ilike', '12%'), ('tax_tag_ids', '=', ref('l10n_pt_reports_arxi.account_tag_intangible_assets')), ('journal_id.type', 'in', ('bank', 'cash', 'general'))]"/><field name="subformula">sum</field></record></field></record><record id="cash_flow_statement_financial_investments" model="account.report.line"><field name="name">Financial Investments</field><field name="code">FINANCIAL_INVESTMENTS</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="expression_ids"><record id="cash_flow_statement_financial_investments_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('credit', '&gt;', 0.0), '|', ('account_id.code', '=ilike', '11%'), ('account_id.code', '=ilike', '12%'), ('tax_tag_ids', '=', ref('l10n_pt_reports_arxi.account_tag_investing_assets')), ('journal_id.type', 'in', ('bank', 'cash', 'general'))]"/><field name="subformula">sum</field></record></field></record><record id="cash_flow_statement_other_assets" model="account.report.line"><field name="name">Other Assets</field><field name="code">OTHER_ASSETS</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="expression_ids"><record id="cash_flow_statement_other_assets_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('credit', '&gt;', 0.0), '|', ('account_id.code', '=ilike', '11%'), ('account_id.code', '=ilike', '12%'), ('tax_tag_ids', '=', ref('l10n_pt_reports_arxi.account_tag_other_assets')), ('journal_id.type', 'in', ('bank', 'cash', 'general'))]"/><field name="subformula">sum</field></record></field></record></field></record><record id="cash_flow_statement_ia_receipts_from" model="account.report.line"><field name="name">Receipts:</field><field name="code">IA_RECEIPTS_FROM</field><field name="children_ids"><record id="cash_flow_statement_rf_fixed_assets" model="account.report.line"><field name="name">Fixed Assets</field><field name="code">RF_FIXED_ASSETS</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="expression_ids"><record id="cash_flow_statement_rf_fixed_assets_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('debit', '&gt;', 0.0), '|', ('account_id.code', '=ilike', '12%'), ('account_id.code', '=i