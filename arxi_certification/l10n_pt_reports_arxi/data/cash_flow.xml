ame="expression_ids"><record id="cash_flow_statement_rf_other_assets_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('debit', '&gt;', 0.0),  '|', ('account_id.code', '=ilike', '12%'), ('account_id.code', '=ilike', '11%'), ('tax_tag_ids', '=', ref('l10n_pt_reports_arxi.account_tag_other_assets')),('journal_id.type','in',('bank','cash', 'general'))]"/><field name="subformula">sum</field></record></field></record><record id="cash_flow_statement_investment_subsidies" model="account.report.line"><field name="name">Investment Subsidies</field><field name="code">INVESTMENT_SUBSIDIES</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="expression_ids"><record id="cash_flow_statement_investment_subsidies_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('debit', '&gt;', 0.0), '|',('account_id.code', '=ilike', '11%'), ('account_id.code', '=ilike', '12%'),('tax_tag_ids', '=', ref('l10n_pt_reports_arxi.account_tag_investing_subsidies')),('journal_id.type','in',('bank','cash','general'))]"/><field name="subformula">sum</field></record></field></record><record id="cash_flow_statement_interest_similar_earnings" model="account.report.line"><field name="name">Interest and similar earnings</field><field name="code">INTEREST_SIMILAR_EARNINGS</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="expression_ids"><record id="cash_flow_statement_interest_similar_earnings_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('debit', '&gt;', 0.0), '|',('account_id.code', '=ilike', '11%'), ('account_id.code', '=ilike', '12%'),('tax_tag_ids', '=', ref('l10n_pt_reports_arxi.account_tag_interest')),('journal_id.type','in',('bank','cash','general'))]"/><field name="subformula">sum</field></record></field></record><record id="cash_flow_statement_dividends" model="account.report.line"><field name="name">Dividends</field><field name="code">DIVIDENDS</field><field name="groupby">move_id</field><field name="foldable" eval="True"/><field name="expression_ids"><record id="cash_flow_statement_dividends_expr" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('debit', '&gt;', 0.0), '|',('account_id.code', '=ilike', '11%'), ('account_id.code', '=ilike', '12%'),('tax_tag_ids', '=', ref('l10n_pt_reports_arxi.account_tag_dividends')),('journal_id.type','in',('bank','cash','general'))]"/><field name="subformula">sum</field></record></field></record></field></record></field></record><record id="cash_flow_statement_financing_activities" model="account.report.line"><field name="name">Fluxos de caixa das actividades de financiamento (3)</field><field name="code">CASH_FLOW_FROM_FINANCING_ACTIVITIES</field><field name="aggregation_formula">OBTAINED_FINANCING.balance + CAPITAL_SUBSCRIPTIONS.balance +
