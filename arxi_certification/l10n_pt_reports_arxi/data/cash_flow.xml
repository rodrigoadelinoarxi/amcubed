ancing')),('journal_id.type','in',('bank','cash','general'))]"/><field name="subformula">sum</field></record></field></record></field></record></field></record><record id="cash_flow_statement_cash_variation" model="account.report.line"><field name="name">Variation of cash and its equivalents: (1)+(2)+(3)</field><field name="code">CASH_VARIATION</field><field name="aggregation_formula">OPERATING_ACTIVITIES.balance + INVESTMENT_ACTIVITIES.balance +
