rt.expression"><field name="label">balance</field><field name="engine">tax_tags</field><field name="formula">model10[02]</field></record></field></record><record id="model_10_other_capital" model="account.report.line"><field name="name">[03] E - Outros Rendimentos de Capitais (aplicável a 2014 e anos anteriores)</field><field name="hierarchy_level">3</field><field name="code">OTHER_INCOME</field><field name="expression_ids"><record id="model_10_categ_e_tag" model="account.report.expression"><field name="label">balance</field><field name="engine">tax_tags</field><field name="formula">model10[03]</field></record></field></record></field></record><record id="model_10_property" model="account.report.line"><field name="name">[05] F - Prediais</field><field name="hierarchy_level">3</field><field name="code">PROPERTY</field><field name="expression_ids"><record id="model_10_categ_f_tag" model="account.report.expression"><field name="label">balance</field><field name="engine">tax_tags</field><field name="formula">model10[05]</field></record></field></record><record id="model_10_increase_wealth" model="account.report.line"><field name="name">[06] G - Incrementos Patrimoniais</field><field name="hierarchy_level">3</field><field name="code">INCREASE_WEALTH</field><field name="expression_ids"><record id="model_10_categ_g_tag" model="account.report.expression"><field name="label">balance</field><field name="engine">tax_tags</field><field name="formula">model10[06]</field></record></field></record><record id="model_10_pensions" model="account.report.line"><field name="name">[07] H - Pensões</field><field name="hierarchy_level">3</field><field name="code">PENSIONS</field><field name="expression_ids"><record id="model_10_categ_h_tag" model="account.report.expression"><field name="label">balance</field><field name="engine">tax_tags</field><field name="formula">model10[07]</field></record></field></record><record id="model_10_irc_withholding" model="account.report.line"><field name="n