on_positive" eval="False"/></record></field></record><record id="model_10_compensation" model="account.report.line"><field name="name">[11] Compensações de IRS/IRC</field><field name="hierarchy_level">3</field><field name="code">COMPENSATION_IRS_IRC</field><field name="expression_ids"><record id="model_10_compensation_expression" model="account.report.expression"><field name="label">balance</field><field name="engine">external</field><field name="formula">sum</field><field name="subformula">editable;rounding=2</field><field name="green_on_positive" eval="False"/></record></field></record><record id="model_10_total" model="account.report.line"><field name="name">[12] TOTAL(09 + 10 + 04 - 11)</field><field name="hierarchy_level">2</field><field name="code">TOTAL</field><field name="aggregation_formula">SUM_01_08.balance + WITHHELD_FLAT_RATES.balance + CREDIT_BALANCES.balance - COMPENSATION_IRS_IRC.balance</field></record><record id="model_10_surcharge" model="account.report.line"><field name="name">[13] Retenção da Sobretaxa (aplicável anos de 2013 a 2017)</field><field name="hierarchy_level">3</field><field name="code">SURCHARGE</field><field name="expression_ids"><record id="model_10_surcharge_expression" model="account.report.expression"><field name="label">balance</field><field name="engine">external</field><field name="formula">sum</field><field name="subformula">editable;rounding=2</field><field name="green_on_positive" eval="False"/></record></field></record></field></record><record id="action_model_10" model="ir.actions.client"><field name="name">Rendimentos e Retenções — Residentes (Modelo 10)</field><field name="tag">account_report</field><field name="context" eval="{'report_id': ref('model_10')}"/></record></odoo>
