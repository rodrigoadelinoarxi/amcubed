<odoo>
    <record id="view_irs_tax_table_form" model="ir.ui.view">
        <field name="name">irs.tax.table.form</field>
        <field name="model">irs.tax.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="income_locale"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <field name="table_line_ids">
                        <list editable="bottom">
                            <field name="value"/>
                            <field name="marginal_rate"/>
                            <field name="to_be_deducted" style="text-align:right;"/>
                            <field name="dependent_val"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_irs_tax_table_tree" model="ir.ui.view">
        <field name="name">irs.tax.table.form</field>
        <field name="model">irs.tax.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="irs_tax_table_action_window" model="ir.actions.act_window">
        <field name="name">IRS Tax Table</field>
        <field name="res_model">irs.tax.table</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>