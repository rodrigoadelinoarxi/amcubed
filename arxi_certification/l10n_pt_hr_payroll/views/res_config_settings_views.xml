<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_l10n_pt_hr_payroll_split_analytic" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.l10n.pt.hr.payroll.split.analytic</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr_payroll_account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//setting[field[@name='batch_payroll_move_lines']]" position="after">
                    <setting name="module_l10n_pt_hr_payroll_split_analytic"
                             string="Apply analytics only to specific accounts"
                             help="When enabled, payroll analytics are applied by salary-rule side configuration (debit and/or credit) on Portuguese payroll structures.">
                        <field name="module_l10n_pt_hr_payroll_split_analytic"/>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
