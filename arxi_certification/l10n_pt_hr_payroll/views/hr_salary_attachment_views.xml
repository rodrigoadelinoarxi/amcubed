<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="l10n_pt_hr_payroll.hr_salary_attachment_view_form" model="ir.ui.view">
        <field name="name">l10n_pt_hr_payroll.hr.salary.attachment.form</field>
        <field name="model">hr.salary.attachment</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_attachment_view_tree"></field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='monthly_amount']" position="attributes">
                <attribute name="widget"></attribute>
            </xpath>
            <xpath expr="//field[@name='total_amount']" position="attributes">
                <attribute name="widget"></attribute>
            </xpath>
        </field>
    </record>
</odoo>