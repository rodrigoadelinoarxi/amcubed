<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_pt_hr_payroll_hr_work_entry_form" model="ir.ui.view">
            <field name="name">l10n_pt_hr_payroll.hr_work_entry.form</field>
            <field name="model">hr.work.entry.type</field>
            <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_form"/>
            <field name="priority" eval="91"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='time_off']" position="inside">
                    <field name="request_days_in_a_row"/>
                    <field name="discounts_salary"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
