<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dmr_wizard_view_form" model="ir.ui.view">
        <field name="name">dmr.wizard.view.form</field>
        <field name="model">export.dmr.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="is_first_declaration" widget="boolean"/>
                            <field name="changes_date" invisible="is_first_declaration"/>
                        </group>
                        <group>
                            <field name="art_119" widget="boolean"/>
                            <field name="fair_impediment" widget="boolean"/>
                            <field name="fair_impediment_reason" invisible="not fair_impediment"/>
                            <field name="fair_impediment_date" invisible="not fair_impediment"/>
                            <field name="fair_impediment_date_end" invisible="not fair_impediment"/>
                            <field name="fair_impediment_date_end" invisible="fair_impediment_reason != '03'"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date_start"/>
                        </group>
                        <group>
                            <field name="date_end"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="execute" string="Export" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="dmr_wizard_action" model="ir.actions.act_window">
        <field name="name">DMR Export</field>
        <field name="res_model">export.dmr.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>