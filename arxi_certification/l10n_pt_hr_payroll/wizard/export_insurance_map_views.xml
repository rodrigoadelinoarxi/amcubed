<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="insurance_map_wizard_view_form" model="ir.ui.view">
        <field name="name">insurance.map.wizard.view.form</field>
        <field name="model">export.insurance.map.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="date_start"/>
                        </group>
                        <group>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group>
                        <field name="policy_number"/>
                        <field name="line_format"/>
                    </group>
                </sheet>
                <footer>
                    <button name="execute" string="Export" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="insurance_map_wizard_action" model="ir.actions.act_window">
        <field name="name">Insurance Map Export</field>
        <field name="res_model">export.insurance.map.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>