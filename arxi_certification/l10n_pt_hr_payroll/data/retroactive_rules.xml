        <field name="retroactive_input_type_id" ref="l10n_pt_hr_payroll.hr_rule_input_retro_wage"/>
        <field name="natrem_code">6</field>
        <field name="in_dmr" eval="True"/>
        <field name="in_dri" eval="True"/>
        <field name="in_accounting" eval="True"/>
    </record>

