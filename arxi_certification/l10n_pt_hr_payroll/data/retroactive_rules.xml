        <field name="code">IRS_RETRO</field>
        <field name="sequence">22</field>
        <field name="struct_id" ref="l10n_pt_hr_payroll.hr_payroll_structure_empregado"/>
        <field name="active">True</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = categories['RETRO'] > 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
baseIH = categories['RETRO']
if baseIH > 0:
    result, result_rate = compute_irs_allowances(contract, categories, employee, payslip, False, False, False, baseIH)
else:
    result_rate = 0
    result = 0
        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="income_type">A</field>
        <field name="in_dmr" eval="True"/>
