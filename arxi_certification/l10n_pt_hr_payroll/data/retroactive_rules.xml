    <record id="hr_payroll_rules_retro_wage" model="hr.salary.rule">
        <field name="category_id" ref="l10n_pt_hr_payroll.hr_payroll_retroactive_irs_ss"/>
        <field name="name">Retroactive Wage</field>
        <field name="code">RETRO_WAGE</field>
        <field name="sequence">15</field>
        <field name="struct_id" ref="l10n_pt_hr_payroll.hr_payroll_structure_empregado"/>
        <field name="active">True</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'RETRO_WAGE' in inputs</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = inputs['RETRO_WAGE'].amount if 'RETRO_WAGE' in inputs else 0
        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="income_type">A</field>
        <field name="ss_code">P</field>
        <field name="in_insurance_map" eval="True"/>
        <field name="insurance_code">P</field>
        <field name="is_retroactive" eval="True"/>
