            <field name="responsible_ids" eval="[(6, 0, [ref('base.user_admin')])]"/>
            <field name="icon_id" ref="hr_holidays.icon_28"/>
            <field name="color">5</field>
        </record>

        <record id="hr_holidays.leave_type_unpaid" model="hr.leave.type">
            <field name="active">False</field>
        </record>

