<?xml version="1.0"?>
<odoo>
    <data noupdate="0">
        <record id="mail_template_payslip" model="mail.template">
            <field name="name">Payroll: Send Payslip</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="subject">{{ object.employee_id.name }}, a new payslip is available for you</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to">{{ object.employee_id.user_partner_id.id }}</field>
            <field name="description">Sent to employee with payslip attached</field>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" style="width:100%; margin:0px auto;">
                    <tbody>
                        <tr>
                            <td valign="top" style="text-align: left; font-size: 14px;">
                                Dear <t t-esc="object.employee_id.name"></t>, a new payslip is available for you.
                                <br/>
                                <br/>
                                Please find the PDF attached.
                                <br/>
                                <br/>
                                Have a nice day,
                                <br/>
                                The HR Team
                            </td>
                        </tr>
                    </tbody>
                </table>
            </field>
            <field name="lang">{{ object.employee_id.user_partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="report_template_ids" eval="[(4, ref('hr_payroll.action_report_payslip'))]"/>
            <!--            <field name="report_name">{{(object.employee_id.name or '')}}</field>-->
        </record>
    </data>
</odoo>