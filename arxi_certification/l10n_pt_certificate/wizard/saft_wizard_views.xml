<odoo><!-- Wizard View To Export SAFT File --><record id="saft_wizard_view_form" model="ir.ui.view"><field name="name">saft.wizard.view.form</field><field name="model">saft.wizard</field><field name="arch" type="xml"><form><field name="state" invisible="True"/><field name="name" invisible="True"/><sheet><group invisible="state != 'choose'"><group><field name="date_start"/></group><group><field name="date_end"/></group></group><group invisible="state != 'choose'"><field name="tax_accounting_basis"/></group><group invisible="state != 'choose'"><field name="selfbilling_partner_id" invisible="tax_accounting_basis != 'S' or get_all_selfbilling_partners" required="tax_accounting_basis == 'S' and not get_all_selfbilling_partners" options="{'no_create_edit': True}"/><field name="get_all_selfbilling_partners" invisible="tax_accounting_basis != 'S'"/><field name="send_selfbilling_email" invisible="tax_accounting_basis != 'S' or not get_all_selfbilling_partners"/></group><group invisible="state != 'get'" col="1"><field name="result" readonly="1" nolabel="1" invisible="not result"/><group col="2"><label for="data"/><field name="data" readonly="1" filename="name" nolabel="1"/></group></group><group invisible="state != 'error'" string="Error"><field name="result" readonly="True" nolabel="1"/><field name="data" readonly="True" filename="name" groups="base.group_system"/></group></sheet><footer><button name="execute" string="Export" type="object" invisible="state != 'choose'" class="oe_highlight"/><button string="Close" special="cancel" class="oe_highlight"/></footer></form></field></record></odoo>
