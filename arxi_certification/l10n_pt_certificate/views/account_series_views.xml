<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="l10n_pt_account_series_view_tree" model="ir.ui.view"><field name="name">l10n_pt.account.series.view.list</field><field name="model">l10n_pt.account.series</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="state"/><field name="series_type"/><field name="document_type_category"/><field name="document_type_id"/><field name="initial_number"/><field name="initial_date"/></list></field></record><record id="l10n_pt_account_series_view_form" model="ir.ui.view"><field name="name">l10n_pt.account.series.view.form</field><field name="model">l10n_pt.account.series</field><field name="arch" type="xml"><form><field name="company_id" invisible="True"/><header><button name="action_activate_non_blocking" type="object" string="Activate" invisible="state != 'draft'" class="oe_highlight"/><button name="action_wizard_set_as_done" type="object" string="Set as Done" invisible="state != 'active'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,done"/></header><sheet><widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/><div class="oe_title"><label for="name"/><h1><field name="name" placeholder="e.g. Customer Invoices" readonly="state != 'draft'"/></h1></div><group><group><field name="active" invisible="True"/><field name="code" readonly="state != 'draft'"/><field name="series_type" readonly="state != 'draft'"/><field name="document_type_category"/><field name="document_type_id" readonly="state != 'draft'"/><field name="invoicing_journal_id" invisible="document_type_category != 'invoicing'" required="document_type_category == 'invoicing'" domain="[('type', 'in', ['sale', 'purchase']), ('l10n_cert', '=', True)]"/><field name="in_name_of" invisible="series_type != 'A'" readonly="state != 'draft'"/><field name="partner_id" invisible="series_type != 'A'" required="series_type == 'A'" readonly="state != 'draft'"/><field name="partner_vat" invisible="partner_id == False"/></group><group><field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/><field name="initial_number" readonly="state != 'draft'"/><field name="last_number" invisible="state != 'done'"/><field name="initial_date" readonly="state != 'draft'"/><field name="validation_code" groups="base.group_no_one" readonly="state != 'draft'"/></group></group><field name="line_ids" readonly="True"><list><field name="res_name" invisible="False"/><field name="res_model" invisible="True"/><field name="res_id" invisible="True"/><field name="sequence_number"/></list></field></sheet></form></field></record><record id="l10n_pt_account_series_action" model="ir.actions.act_window"><field name="name">Series</field><field name="res_model">l10n_pt.account.series</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                Add a series
            </p><p>
                A series is used to create a portuguese certified document numbering sequence.
            </p></field></record></odoo>
