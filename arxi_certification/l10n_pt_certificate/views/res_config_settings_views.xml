                        </div></div></setting></xpath><xpath expr="//setting[@id='tax_fiscal_country_234']" position="after"><div class="col-12 col-lg-6 o_setting_box" id="tax_country_region" invisible="not qr_code_pt" groups="l10n_pt_ao_access.group_allow_cert_settings"><div class="o_setting_left_pane"/><div class="o_setting_right_pane"><span class="o_form_label">Domestic Region</span><span class="fa fa-lg fa-building-o" title="Values set here are company-specific." role="img" aria-label="Values set here are company-specific." groups="base.group_multi_company"/><div class="text-muted">
                            Domestic region country of your accounting
                        </div><div class="text-muted"><field name="l10n_pt_country_region"/></div></div></div></xpath><xpath expr="//block[@id='invoicing_settings']" position="inside"><div id="portuguese_at_gt_setting" class="col-12 col-lg-6 o_setting_box" groups="l10n_pt_ao_access.group_allow_cert_settings"><div class="o_setting_left_pane"><field name="l10n_pt_at_webservice" readonly="False"/></div><div class="o_setting_right_pane"><label for="l10n_pt_at_webservice" string="Portuguese TA Webservice"/><span class="fa fa-lg fa-building-o" title="Values set here are company-specific."/><div class="text-muted">
                            Activate to integrate with the Portuguese Tax Authority Webservice.
                        </div><div class="content-group" invisible="not l10n_pt_at_webservice"><div class="row mt8"><label for="l10n_pt_at_test" class="col-lg-4 o_light_label" string="Test Environment"/><field name="l10n_pt_at_test"/></div><!-- Etapa 5.7: criação automática de séries opcional --><div class="row mt8"><label for="l10n_pt_series_auto_create" class="col-lg-4 o_light_label" string="Automatic Series Creation"/><field name="l10n_pt_series_auto_create"/></div><div class="row mt8"><label class="col-lg-4 o_light_label" string="Username" for="l10n_pt_at_api_username"/><field name="l10n_pt_at_api_username" required="l10n_pt_at_webservice"/></div><div class="row mt8"><label class="col-lg-4 o_light_label" string="Password" for="l10n_pt_at_api_password"/><field name="l10n_pt_at_api_password" password="True" required="l10n_pt_at_webservice"/></div></div><div class="d-flex align-items-center" invisible="not l10n_pt_at_webservice"><button name="action_import_l10n_pt_series" icon="fa-arrow-right" type="object" string="Import Series" class="btn-link p-1"/><span class="text-muted">(using the TA Webservice)</span></div></div></div></xpath><xpath expr="//setting[@id='rounding_method']" position="inside"><label string="We recommend &quot;Round per Tax&quot; for PT Companies" for="tax_calculation_rounding_method" class="alert alert-warning" role="alert"/></xpath></field></record></odoo>
