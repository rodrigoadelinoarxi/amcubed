<odoo><record id="res_config_settings_view_form" model="ir.ui.view"><field name="name">res.config.settings.view.form.inherit.</field><field name="model">res.config.settings</field><field name="inherit_id" ref="account.res_config_settings_view_form"/><field name="arch" type="xml"><xpath expr="//setting[@id='qr_code_invoices']" position="after"><setting id="qr_code_pt" title="Add a QR-code to your PT documents." company_dependent="1" help="Adds a QR Code to all portuguese certified documents" groups="l10n_pt_ao_access.group_allow_cert_settings"><field name="qr_code_pt" class="oe_inline"/></setting><setting class="col-xs-12 col-md-6 o_setting_box" id="qr_code_position" company_dependent="1"><div class="row mt8"><label string="QR Code Position " for="qr_code_position"/><span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/></div><div class="row mt8"><field name="qr_code_position" class="oe_inline"/><div class="text-muted">
                                Customize the position of the QR Code in your Documents
                            </div></div></setting><setting class="col-xs-12 col-md-6 o_setting_box" id="pt_arxi_lines_per_page" company_dependent="1" groups="l10n_pt_ao_access.group_allow_cert_settings"><div class="row mt8"><label string="Report Lines per Page" for="pt_arxi_lines_per_page"/><span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/></div><div class="row mt8"><field name="pt_arxi_lines_per_page" class="oe_inline"/><div class="text-muted">
