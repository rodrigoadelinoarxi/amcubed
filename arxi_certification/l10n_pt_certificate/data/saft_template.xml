_repr(doc.net_total) or 0"/><GrossTotal t-esc="round_repr(doc.gross_total)"/><Currency t-if="doc.currency_name and doc.currency_name != currency.name"><CurrencyCode t-esc="doc.currency_name"/><CurrencyAmount t-esc="doc.currency_amount"/><ExchangeRate t-esc="doc.currency_rate"/></Currency></DocumentTotals></WorkDocument></WorkingDocuments><Payments t-if="payments"><NumberOfEntries t-esc="len(payments)"/><TotalDebit t-esc="round_repr(abs(sum(payments.filtered(lambda p: p.move_id.pt_arxi_status_id.code != 'A').mapped('payment_line_ids').filtered(lambda m: m.invoice_id.move_type == 'out_refund' or m.external_invoice_name and m.original_amount &lt; 0).mapped('original_amount'))))"/><TotalCredit t-esc="round_repr(abs(sum(payments.filtered(lambda p: p.move_id.pt_arxi_status_id.code != 'A').mapped('payment_line_ids').filtered(lambda m: m.invoice_id.move_type == 'out_invoice' or m.external_invoice_name and m.original_amount &gt; 0).mapped(lambda line: line.amount / (line.payment_id.currency_rate or 1.0)))))"/><Payment t-foreach="payments" t-as="p"><PaymentRefNo t-esc="p.payment_name"/><ATCUD t-esc="p.pt_arxi_atcud or '0'"/><Period t-esc="p.posting_date.month"/><TransactionDate t-esc="p.posting_date"/><PaymentType>RG</PaymentType><Description t-if="False"/><SystemID t-if="False"/><DocumentStatus><PaymentStatus t-esc="p.move_id.pt_arxi_status_id.code"/><PaymentStatusDate t-esc="p.move_id.status_date_pt"/><Reason t-esc="p.reason or p.move_id.reason"/><SourceID t-esc="p.move_id.user_source_id.id"/><SourcePayment t-esc="p.source_billing"/></DocumentStatus><PaymentMethod><PaymentMechanism t-if="p.payment_method_line_id.payment_mechanism_id" t-esc="p.payment_method_line_id.payment_mechanism_id.code"/><PaymentAmount t-esc="'%.2f' % abs(p.amount_company_currency_signed)"/><PaymentDate t-esc="p.date"/></PaymentMethod><SourceID t-esc="p.create_uid.id"/><SystemEntryDate t-esc="p.validated_date_pt"/><CustomerID t-esc="p.partner_id.commercial_partner_id.ref"/><Line t-foreach="p.payment_li