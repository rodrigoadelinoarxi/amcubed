<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1"><record id="mail_template_saft_self_billing" model="mail.template"><field name="name">SAF-T Self-Billing</field><field name="model_id" ref="base.model_res_partner"/><field name="subject">SAF-T Self-Billing File - {{ ctx.get('date_start') }} to {{ ctx.get('date_end') }}</field><field name="email_from">{{ user.email_formatted or '' }}</field><field name="email_to">{{ object.email or '' }}</field><field name="lang">{{ object.lang }}</field><field name="auto_delete" eval="True"/><field name="body_html" type="html"><div>
                    Dear <t t-out="object.name or ''">Partner</t>,<br/><br/>
                    Please find attached your SAF-T self-billing file for the period from
                    <t t-out="ctx.get('date_start')">2026-01-01</t> to
                    <t t-out="ctx.get('date_end')">2026-01-31</t>.<br/><br/>
                    Best regards,<br/>
                    <t t-out="user.company_id.name or ''">Company</t>
                </div></field></record></data></odoo>
