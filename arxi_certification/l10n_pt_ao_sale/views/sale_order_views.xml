<?xml version="1.0" encoding="utf-8"?>
<odoo><!--Form view--><record id="view_order_form" model="ir.ui.view"><field name="name">sale.order.form.inherit.l10n_pt_ao_sale</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><!-- Absorbed from sale_journals: journal/type fields and layout groups.
                 These xpaths must run before the rest of this view, which builds on
                 the 'sale_info_main'/'other_info_sep' groups and the sale_journal field. --><!--Sale order Name or 'Draft'--><xpath expr="//field[@name='name']" position="replace"><span invisible="state != 'draft' or name != '/'">Draft</span><field name="name" readonly="True" invisible="name == '/'"/></xpath><!--Create a new group with the invoicing group and the new other info group--><xpath expr="//group[@name='sale_info']" position="before"><group name="sale_info_main"/></xpath><xpath expr="//group[@name='sale_info_main']" position="inside"><xpath expr="//group[@name='sale_info']" position="move"/></xpath><xpath expr="//group[@name='sale_info']" position="attributes"><attribute name="class">mt-0</attribute><attribute name="colspan">2</attribute></xpath><!--Add journal and sale document type--><xpath expr="//group[@name='sale_info_main']" position="inside"><group name="other_info_sep" string="Other Info" colspan="2" class="mt-0"><field name="sale_journal" string="Sale Journal" required="True" options="{'no_create_edit': True}" readonly="state != 'draft'" domain="[('sale_type_id', '=', sale_type_id)]"/><field name="sale_type_id" readonly="True"/></group></xpath><xpath expr="//header" position="inside"><button name="action_quotation_sent" string="Post" type="object" invisible="state != 'draft'" class="btn-primary" data-hotkey="v"/></xpath><!-- Absorbed from print_conf_copies_sales --><xpath expr="//group[@name='sale_shipping']/.." position="after"><group><group name="print_conf" string="Print Configurations"><field name="print_copies"/></group></group></xpath><!--Hide draft send button--><xpath expr="//button[@name='action_quotation_send' and @invisible='state'!='draft']" position="attributes"><attribute name="class">btn-default</attribute></xpath><xpath expr="//button[@name='action_open_discount_wizard']" position="attributes"><attribute name="invisible">not is_editable</attribute></xpath><!--Hide draft send proforma button--><xpath expr="//button[@name='action_quotation_send'][2]" position="attributes"><attribute name="invisible">True</attribute></xpath><xpath expr="//button[@name='action_quotation_send'][3]" position="attributes"><attribute name="invisible">sale_journal.l10n_pt_ao_certified</attribute></xpath><!--Hide draft confirm button--><xpath expr="//button[@name='action_confirm'][2]" position="attributes"><attribute name="invisible">True</attribute></xpath><!--Hide cancel button in draft state--><xpath expr="//button[@name='action_cancel']" position="attributes"><attribute name="invisible">state not in ['sent', 'sale'] or not id</attribute></xpath><xpath expr="//button[@name='action_open_discount_wizard']" position="attributes"><attribute name="invisible">not is_editable</attribute></xpath><!--Sale Order Other Info--><xpath expr="//group[@name='other_info_sep']" position="inside"><field name="pt_arxi_inalterable_hash" invisible="True"/><field name="pt_arxi_inalterable_hash" groups="base.group_no_one"/></xpath><!--Hide draft button in cancel state--><xpath expr="//button[@name='action_draft']" position="attributes"><attribute name="invisible">state != 'cancel' or not pt_arxi_inalterable_hash</attribute></xpath><xpath expr="//button[@name='action_unlock']" position="attributes"><attribute name="invisible">not locked</attribute></xpath><xpath expr="//field[@name='partner_id']" position="before"><field name="is_editable" invisible="True"/></xpath><xpath expr="//field[@name='partner_invoice_id']" position="attributes"><attribute name="readonly">not is_editable or state == 'cancel' or locked</attribute></xpath><xpath expr="//field[@name='partner_shipping_id']" position="attributes"><attribute name="readonly">not is_editable or state == 'cancel' or locked</attribute></xpath><xpath expr="//field[@name='sale_order_template_id']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><xpath expr="//group[@name='order_details']//div[hasclass('o_td_label')][1]" position="attributes"><attribute name="groups"/><attribute name="invisible">state not in ['draft', 'sent']</attribute></xpath><xpath expr="//field[@name='date_order'][1]" position="attributes"><attribute name="groups"/><attribute name="invisible">state not in ['draft', 'sent']</attribute><attribute name="readonly">not is_editable</attribute></xpath><xpath expr="//group[@name='order_details']//div[hasclass('o_td_label')][2]" position="attributes"><attribute name="invisible">state in ['draft', 'sent']</attribute></xpath><xpath expr="//field[@name='date_order'][2]" position="attributes"><attribute name="readonly">not is_editable</attribute><attribute name="invisible">state in ['draft', 'sent']</attribute></xpath><xpath expr="//field[@name='validity_date']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><xpath expr="//field[@name='partner_id']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><xpath expr="//field[@name='pricelist_id']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><xpath expr="//field[@name='payment_term_id']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><xpath expr="//field[@name='note']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><xpath expr="//field[@name='user_id']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><xpath expr="//group[@name='sales_person']/field[@name='company_id']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><xpath expr="//group[@name='sale_info']//field[@name='fiscal_position_id']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><!--Sale Order Line Tree--><xpath expr="//field[@name='order_line']" position="attributes"><attribute name="readonly">state not in ['draft'] and not is_editable</attribute></xpath><xpath expr="//field[@name='order_line']//list" position="inside"><field name="line_warning" column_invisible="True"/></xpath><xpath expr="//field[@name='client_order_ref']" position="attributes"><attribute name="readonly">not is_editable</attribute></xpath><xpath expr="//field[@name='sale_journal']" position="attributes"><attribute name="options">{'no_create': True}</attribute></xpath><xpath expr="//sheet" position="before"><field name="has_certified_journal" invisible="True"/><field name="line_warning" invisible="True"/><div class="alert alert-warning mb-0" role="alert" invisible="has_certified_journal or country_code not in ['PT', 'AO']"><h5>You are using a base Odoo Journal</h5></div><div class="alert alert-warning mb-0" role="alert" invisible="not line_warning"><h5>A Line Description was shortened to 200 characters.</h5></div></xpath><!--Same "Status" tab already shown on invoices/credit notes
            (see l10n_pt_ao/views/account_move_views.xml) — the
            document.status.mixin/mixin fields (pt_arxi_status_id/
            pt_arxi_status_date/user_source_id/reason) exist on
            sale.order too but had nowhere to be seen on the form; the
            only way to ever set ``reason`` was the mass-cancel wizard
            from the list view, invisible from here (Dylan, 2026-08-28,
            UAT 24 follow-up).--><xpath expr="//page[@name='other_information']" position="after"><page string="Status" name="status" groups="base.group_no_one"><group><group><field name="pt_arxi_status_id"/><field name="pt_arxi_status_date"/><field name="user_source_id"/></group><group><field name="reason"/></group></group></page></xpath></field></record><!--Remove print and download buttons from portal view in draft sales--><template id="sale_order_portal_template" inherit_id="sale.sale_order_portal_template"><xpath expr="//t[@t-set='entries']/div/div" position="attributes"><attribute name="t-att-style">'display: none;' if sale_order.state == 'draft' else ''</attribute></xpath></template><!-- v19: sale.order.option foi removido pela Odoo (produtos opcionais nas
         propostas). O template pai sale_order_portal_content_inherit_sale_management
         e o botão js_add_optional_products deixaram de existir, portanto o override
         que os escondia em documentos certificados perdeu alvo e propósito. Removido. --><record id="rewrite" model="ir.actions.server"><field name="name">Rewrite</field><field name="model_id" ref="sale.model_sale_order"/><field name="binding_model_id" ref="sale.model_sale_order"/><field name="state">code</field><field name="code">
            if record:
            action = record.action_rewrite()
        </field></record><!-- Absorbed from sale_journals --><!--Add domain to the existing quotation action--><record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window"><field name="domain">[('sale_type_id.code', '=', 'OR')]</field></record><record id="action_view_proforma" model="ir.actions.server"><field name="name">Proforma Invoices</field><field name="model_id" ref="sale.model_sale_order"/><field name="binding_model_id" ref="sale.model_sale_order"/><field name="state">code</field><field name="group_ids" eval="[(6, 0, [ref('sale.group_proforma_sales')])]"/><field name="code">
            action = model.action_view_proforma()
        </field></record><record id="action_other_docs" model="ir.actions.act_window"><field name="name">Other Type of Sales</field><field name="type">ir.actions.act_window</field><field name="res_model">sale.order</field><field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field><field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/><field name="context">{'search_default_my_quotation': 1, 'default_sale_type': 'OU'}</field><field name="domain">[('sale_type_id.code', '=', 'OU')]</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                Create a new sale!
            </p></field></record></odoo>
