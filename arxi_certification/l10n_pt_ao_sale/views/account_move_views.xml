<?xml version="1.0" encoding="utf-8"?>
<odoo><!--Overriding invoice form add selfpaid invoicing options and a global discount--><record id="l10n_pt_ao_sale_invoice_form" model="ir.ui.view"><field name="name">account.invoice.form.inherit.l10n_pt_ao_sale</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//field[@name='invoice_date']" position="after"><field name="downpayment_move" invisible="True"/></xpath><xpath expr="//field[@name='invoice_line_ids']/list//field[@name='product_id']" position="attributes"><attribute name="readonly">parent.downpayment_move or parent.state != 'draft'</attribute></xpath></field></record></odoo>
