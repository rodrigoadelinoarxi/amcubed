<?xml version="1.0" encoding="utf-8"?>
<odoo><!-- Absorbed from print_conf_copies_sales: wraps the document call in a loop
         that renders one copy per print_copies (Original/Duplicate/...).
         MUST keep priority 10 so it runs BEFORE report_saleorder below: this one
         builds the loop around the t-call, the other one then swaps that t-call
         for the per-country template. Inverting the order breaks both features. --><template id="report_saleorder_raw" inherit_id="sale.report_saleorder_raw" priority="10"><xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace"><t t-set="copies" t-value="int(doc.print_copies)"/><t t-foreach="range(1, copies + 1)" t-as="print_type"><t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/></t></xpath></template><!-- Absorbed from print_conf_copies_sales --><template id="report_saleorder_pro_forma" inherit_id="sale.report_saleorder_pro_forma" priority="10"><xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace"><t t-set="copies" t-value="int(doc.print_copies)"/><t t-foreach="range(1, copies + 1)" t-as="print_type"><t t-if="doc.company_id.country_id.code == 'PT'"><t t-call="l10n_pt_sale.report_saleorder_document" t-lang="doc.partner_id.lang"/></t><t t-else=""><t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/></t></t></xpath></template><!-- Absorbed from print_conf_copies_sales: prints the copy label
         (Original/Duplicate/...) driven by the print_type of the loop above. --><template id="report_saleorder_document" inherit_id="sale.report_saleorder_document" priority="10"><xpath expr="//span[@t-field='doc.name']/.." position="after"><t t-if="doc.company_id.country_id.code in ['PT', 'AO']"><span class="text-nowrap" t-if="print_type == 1"><t t-if="not doc.doc_printed">Original</t><t t-else="">Copy of the document - Original</t></span><span class="text-nowrap" t-if="print_type == 2"><t t-if="not doc.doc_printed">Duplicate</t><t t-else="">Copy of the document - Duplicate</t></span><span class="text-nowrap" t-if="print_type == 3"><t t-if="not doc.doc_printed">Triplicate</t><t t-else="">Copy of the document - Triplicate</t></span><span class="text-nowrap" t-if="print_type == 4"><t t-if="not doc.doc_printed">Quadruplicate</t><t t-else="">Copy of the document - Quadruplicate</t></span></t></xpath><!-- Absorbed from sale_journals: force the sale document type name in the
             document title for PT/AO companies. --><xpath expr="//t[@t-set='layout_document_title']" position="attributes"><attribute name="t-if">doc.company_id.country_id.code not in ['PT', 'AO']</attribute></xpath><xpath expr="//t[@t-set='layout_document_title']" position="after"><t t-else="" t-set="layout_document_title"><t><span t-field="doc.sale_journal.sale_type_id.name"/> 
                </t><span t-field="doc.name"/></t></xpath></template><!-- Absorbed from sale_report_by_country: lets each localization render its
         own sale order template through the _get_name_sale_report() hook.
         Priority 16 (explicit): must run AFTER report_saleorder_raw above. --><template id="report_saleorder" inherit_id="sale.report_saleorder_raw" priority="16"><xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace"><t t-call="#{ doc._get_name_sale_report() }" t-lang="doc.partner_id.lang"/></xpath></template><template id="report_saleorder_document_tweaks" inherit_id="sale.report_saleorder_document" priority="100"><xpath expr="//div[hasclass('page')]" position="inside"><t t-call="l10n_pt_ao.report_staging_warning" t-lang="lang"/></xpath><!-- v19: a tabela de linhas do report foi reestruturada. A linha de produto
             normal deixou de estar em td[@name='td_name'] e passou a
             td[@name='td_product_name'] (ver sale/report/ir_actions_report_templates.xml).
             Mantemos o override que troca o nome renderizado por _get_report_name(). --><xpath expr="//td[@name='td_product_name']/span" position="replace"><span t-out="line._get_report_name()" t-options="{'widget': 'text'}"/></xpath><xpath expr="//span[@t-field='doc.note']" position="attributes"><attribute name="t-if">not is_html_empty(doc.note) and not doc.needs_separate_comment_report</attribute></xpath><xpath expr="//div[hasclass('page')]" position="after"><t t-if="not is_html_empty(doc.note) and doc.needs_separate_comment_report"><t t-call="l10n_pt_ao_sale.report_terms_and_conditions" t-lang="lang"/></t></xpath></template><template id="report_terms_and_conditions"><t t-set="doc" t-value="doc.with_context(lang=lang)"/><div class="page" style="page-break-before: always;"><p class="fake_h3 mb-0">Terms &amp; Conditions</p><hr class="mt-0 mb-1"/><span name="comment" t-field="doc.note"/></div></template></odoo>
