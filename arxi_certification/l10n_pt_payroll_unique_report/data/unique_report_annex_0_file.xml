                            <encarg_accao><t t-esc="int(o.social_support_charges) or 0"/></encarg_accao>

                            <poten_max_anual><t t-esc="int(o.max_annual_potential) or 0"/></poten_max_anual>

                            <t t-if="o.not_worked_hours_table">
                                <horas_n_trab_ano>
                                    <t t-foreach="o.not_worked_hours_table" t-as="line">
                                        <horas_n_trab>
                                            <motivo tbl="RU_MHNT">
                                                <t t-esc="line.not_worked_hours_reason.code"/>
                                            </motivo>
                                            <horas_aus_remun>
                                                <h><t t-esc="int(line.paid_leave_hours_male) or 0"/></h>
                                                <m><t t-esc="int(line.paid_leave_hours_female) or 0"/></m>
                                            </horas_aus_remun>
                                            <horas_aus_n_remun_h>
                                                <h><t t-esc="int(line.unpaid_leave_hours_male) or 0"/></h>
                                                <m><t t-esc="int(line.unpaid_leave_hours_female) or 0"/></m>
                                            </horas_aus_n_remun_h>
                                        </horas_n_trab>
                                    </t>
                                </horas_n_trab_ano>
