                        <vol_negocios t-att-ano="o.business_volume_year"><t
                                t-esc="int(o.business_volume) or 0"/></vol_negocios>

                        <capital_social><t t-esc="int(o.social_capital) or 0"/></capital_social>
                        <cap_social_priv_nac><t
                                t-esc="o.social_capital_rep_private_national * 100 or 0.0"/></cap_social_priv_nac>
                        <cap_social_estrang><t t-esc="o.social_capital_rep_foreign * 100 or 0.0"/></cap_social_estrang>
                        <cap_social_pub_nac><t
                                t-esc="o.social_capital_rep_public_national * 100 or 0.0"/></cap_social_pub_nac>

                        <finan_ent><t t-esc="int(o.company_funded_amount) or 0"/></finan_ent>
                        <mont_remun_horas_form><t
                                t-esc="int(o.company_funded_amount_hours) or 0"/></mont_remun_horas_form>
                        <rest_finan_ent><t t-esc="int(o.company_funded_amount_remaining) or 0"/></rest_finan_ent>
                        <finan_ext_ent><t t-esc="int(o.external_funded_amount) or 0"/></finan_ext_ent>
                        <finan_fse><t t-esc="int(o.external_funded_amount_esf) or 0"/></finan_fse>
                        <finan_outras_fontes><t t-esc="int(o.external_funded_amount_other) or 0"/></finan_outras_fontes>

                        <encarg_globais_form_prof><t
