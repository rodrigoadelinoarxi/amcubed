                        <encarg_org_sst><t t-esc="int(o.safety_health_management_charges) or 0"/></encarg_org_sst>
                        <encarg_org_esp_trab><t t-esc="int(o.workspace_management_charges) or 0"/></encarg_org_esp_trab>
                        <encarg_aqui_bens><t t-esc="int(o.goods_services_aquisition_charges) or 0"/></encarg_aqui_bens>
                        <encarg_form><t t-esc="int(o.consulting_info_training_charges) or 0"/></encarg_form>
                        <encarg_outros><t t-esc="int(o.other_charges) or 0"/></encarg_outros>
                        <encarg_total><t t-esc="int(o.total_charges) or 0"/></encarg_total>

                        <outros_dados_comp_31Out t-if="o.had_ten_employees_in_october">
                            <vab t-att-ano="o.gross_added_value_year or 2025">
                                <t t-esc="int(o.gross_added_value) or 0"/>
                            </vab>

                            <custos_pessoal><t t-esc="int(o.personnel_cost) or 0"/></custos_pessoal>
                            <amort_exerc><t t-esc="int(o.year_amortization) or 0"/></amort_exerc>
                            <provi_exerc><t t-esc="int(o.year_provision) or 0"/></provi_exerc>
                            <custos_perdas><t t-esc="int(o.financial_costs_and_losses) or 0"/></custos_perdas>
                            <impost_rend><t t-esc="int(o.income_tax) or 0"/></impost_rend>
                            <res_liquido><t t-esc="int(o.net_income) or 0"/></res_liquido>

                            <encarg_admin>
                                <subs_doenca>
                                    <valor><t t-esc="int(o.sick_allowance)"/></valor>
                                    <origem_encargo tbl="RU_ORIENC"><t
                                            t-esc="o.sick_allowance_code.code if o.sick_allowance_code else 0"/></origem_encargo>
                                </subs_doenca>
                                <pensoes>
                                    <valor><t t-esc="int(o.age_allowance)"/></valor>
                                    <origem_encargo tbl="RU_ORIENC"><t
                                            t-esc="o.age_allowance_code.code if o.age_allowance_code else 0"/></origem_encargo>
                                </pensoes>
                                <outras>
                                    <valor><t t-esc="int(o.other_ss_charges)"/></valor>
                                    <origem_encargo tbl="RU_ORIENC"><t
                                            t-esc="o.other_ss_charges_code.code if o.other_ss_charges_code else 0"/></origem_encargo>
                                </outras>
                            </encarg_admin>


                            <encarg_n_admin>
                                <subs_doenca>
                                    <valor><t t-esc="int(o.not_supported_sick_allowance)"/></valor>
                                    <origem_encargo tbl="RU_ORIENC"><t
                                            t-esc="o.not_supported_sick_allowance_code.code if o.not_supported_sick_allowance_code else 0"/></origem_encargo>
                                </subs_doenca>
                                <pensoes>
                                    <valor><t t-esc="int(o.not_supported_age_allowance)"/></valor>
                                    <origem_encargo tbl="RU_ORIENC"><t
                                            t-esc="o.not_supported_age_allowance_code.code if o.not_supported_age_allowance_code else 0"/></origem_encargo>
