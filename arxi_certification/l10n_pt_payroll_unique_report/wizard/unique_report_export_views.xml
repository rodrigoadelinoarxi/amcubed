<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_unique_report_export_wizard" model="ir.ui.view">
        <field name="name">unique.report.export.wizard.form</field>
        <field name="model">unique.report.export.wizard</field>
        <field name="arch" type="xml">
            <form string="UR XML Export">
                <sheet>
                    <field name="state" invisible="1"/>
                    <field name="xml_filename" invisible="1"/>

                    <group invisible="state != 'error'">
                        <field name="result" readonly="1"/>
                    </group>

                    <group invisible="state not in ('get', 'error')">
                        <field name="xml_file" filename="xml_filename" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
