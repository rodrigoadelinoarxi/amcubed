<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- v19: hr.contract foi fundido em hr.version, que nao tem form view
             propria. Os campos de contrato editam-se na ficha do colaborador
             (hr.view_employee_form, page "payroll_information"), via
             _inherits = {'hr.version': 'version_id'} em hr.employee. -->
        <record id="hr_contract_view_form_l10n_pt_payroll" model="ir.ui.view">
            <field name="name">hr.version.view.form.l10n.pt.unique.report</field>
            <field name="model">hr.employee</field>
            <field name="priority">21</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='payroll_information']//div[@name='contract_dates']" position="after">
                    <field name="entry_reason"/>
                    <field name="exit_reason" invisible="not contract_date_end"/>
                </xpath>
                <xpath expr="//page[@name='payroll_information']//field[@name='contract_type_id']" position="after">
                    <field name="contract_type"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
