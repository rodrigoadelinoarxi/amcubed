<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='col_left']/parent::div" position="after">
                <field name="is_training" invisible="1"/>
                <field name="is_strike" invisible="1"/>
                <group name="Training" string="Training" invisible="not is_training">
                    <group>
                        <group>
                            <field name="training_frequency"/>
                            <field name="training_ref_period"/>
                            <field name="training_area"/>
                            <field name="training_type"/>
                        </group>
                        <group>
                            <field name="training_initiative"/>
                            <field name="training_schedule"/>
                            <field name="training_entity"/>
                            <field name="training_certificate_type"/>
                            <field name="training_qualification_level"/>
                        </group>
                    </group>
                </group>
                <group name="Strike" string="Strike" invisible="not is_strike">
                    <group>
                        <field name="strike_code"/>
                        <field name="strike_claim"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <record id="hr_leave_view_form_manager_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='strike_claim']" position="after">
                <field name="strike_result"/>
            </xpath>
        </field>
    </record>
</odoo>