<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_employee_form_unique_report_form" model="ir.ui.view">
            <field name="name">hr.employee.inherit.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="priority">30</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='study_school']" position="after">
                    <field name="literacy_habilitations"/>
                    <field name="qualification_level"/>
                </xpath>
                <xpath expr="//field[@name='contrib_entity']" position="after">
                    <field name="social_security_regimen"/>
                </xpath>
                <xpath expr="//page[@name='public']" position="inside">
                    <group string="Unique Report">
                        <group>
                            <field name="last_promotion_date"/>
                            <field name="job_situation"/>
                            <field name="job_ur"/>
                            <field name="irct_regulation"/>
                            <field name="irct_applicability"/>
                        </group>
                        <group>
                            <field name="job_category"/>
                            <field name="qualification_level"/>
                            <field name="work_duration_regimen"/>
                            <field name="working_time_duration"/>
                            <field name="working_time_organization"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//page[@name='hr_settings']" position="after">
                    <page string="Training" groups="hr.group_hr_user">
                        <group>
                            <button name="compute_training_hours" type="object"
                                    string="Refresh Training Hours"
                                    class="btn-link" icon="fa-refresh"/>
                        </group>
                        <field name="training_history_ids">
                            <list editable="bottom">
                                <field name="year"/>
                                <field name="training_hours"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
