<?xml version="1.0"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_pt_ao_pos.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <!-- v19: the TicketScreen order list is a headerless table of
             <tr class="order-row"><td>…</td></tr>. Show the certified document
             number (account_move_name) right after the order-name cell. -->
        <xpath expr="//tr[hasclass('order-row')]/td[hasclass('order-name')]" position="after">
            <td class="align-middle">
                <div class="fw-bolder"><t t-esc="order.account_move_name or ''"/></div>
            </td>
        </xpath>
    </t>
</templates>
