<?xml version="1.0"?>
<odoo><record id="invoice_form_inherit_l10n_pt_saphety" model="ir.ui.view"><field name="name">l10n.pt.saphety.invoice.form</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//field[@name='partner_shipping_id']" position="before"><field name="edi_document_ids" invisible="1"/><field name="outbound_doc_id" readonly="state != 'draft' and edi_document_ids" invisible="move_type not in ['out_invoice', 'out_refund']"/></xpath><!-- CMP-015: 'reason' é campo injetado pelo l10n_pt_ao (frágil como anchor);
