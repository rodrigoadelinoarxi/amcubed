<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Security groups for Import BOM  -->
    <record id="import_bom_group_id" model="res.groups">
        <field name="name">Import BOM</field>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="category_id" ref="base.module_category_manufacturing_manufacturing"/>
    </record>

    <record id="mrp.group_mrp_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('import_bom_group_id'))]"/>
    </record>

</odoo>

