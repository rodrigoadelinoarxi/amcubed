<odoo>

    <template id="inline_form">
        <small>You will get redirected to provide the card information after submiting your email</small>
        <div class="row">
            <div class="col-sm-12 form-group">
                <label for="email">Email</label>
                <div class="input-group">
                    <input type="email" id="email"
                           required="" t-att-value="request.env.user.partner_id.email" class="form-control"/>
                </div>
            </div>
        </div>
    </template>

</odoo>
