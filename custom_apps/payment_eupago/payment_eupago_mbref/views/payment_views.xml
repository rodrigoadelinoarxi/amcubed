<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="acquirer_form_eupago" model="ir.ui.view">
        <field name="name">acquirer.form.eupago</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr='//group[@name="provider_credentials"]' position='after'>
                <group invisible="code != 'eupago_mbref'">
                    <field name="payment_confirmation_action"/>
                    <field name="eupago_days_deadline"/>
                    <field name="eupago_secret_key"/>
                    <field name="eupago_multibanco_minimum_amount"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
