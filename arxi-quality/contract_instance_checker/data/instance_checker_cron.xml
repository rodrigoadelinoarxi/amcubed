<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron Job: Daily contract validation with central server -->
        <record id="cron_validate_instance_contract" model="ir.cron">
            <field name="name">Instance Checker: Validate Contract Daily</field>
            <field name="model_id" ref="model_contract_instance_status"/>
            <field name="state">code</field>
            <field name="code">model._cron_validate_contract()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

    </data>
</odoo>
