<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="check_out_inherit" inherit_id="website_sale.total">
        <xpath expr="//div[@id='cart_total']//table//tr[@id='order_total_taxes']" position="after">
            <tr id="order_total_fees" t-if="request.httprequest.path != '/shop/cart'">
                <t t-set="fees_t"
                   t-value="sum(l.price_subtotal for l in website_sale_order.order_line.filtered(lambda l: l.is_extra_fees))"/>
                <t t-set="fees_percent"
                   t-value="round((fees_t / website_sale_order.amount_total) * 100) if website_sale_order.amount_total > 0 else 0"/>

                <t t-if="fees_t > 0">
                    <td colspan="2" class="border-0 pb-2 ps-0 pt-0 text-start text-muted">
                        Service charge (<span t-out="fees_percent" style="color: green;"/> <span t-out="'%'" style="color: green;"/>)<span style="font-size:9px;"> (incl. in total)</span>
                    </td>
                </t>
                <t t-else="">
                    <td colspan="2" class="border-0 pb-2 ps-0 pt-0 text-start text-muted">
                        Service charge <span class="method_fees_percentage" style="color: green;">(0%)
                    </span> <!-- Displaying the fees percentage -->
                    </td>
                </t>

                <td class="text-end border-0 pb-2 pe-0 pt-0" data-total-fees="0">
                    <t t-set="fees_percent" t-value="0"/>
                    <!-- Correct usage of sum function -->
                    <t t-set="ttotal_fees" t-value="(fees_percent / 100) * website_sale_order.amount_total"/>
                    <t t-if="fees_t > 0">
                        <span t-out="fees_t"
                              class="monetary_field"
                              style="white-space: nowrap; color: green;"
                              t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                    </t>
                    <t t-else="">
                        <span style="color: green;">(+)</span>
                        <span t-out="ttotal_fees"
                              class="monetary_field"
                              style="white-space: nowrap; color: green;"
                              t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"/>
                    </t>
                </td>
            </tr>
        </xpath>
        <xpath expr="//tr[@id='order_total']//td[2]" position="attributes">
            <attribute name="t-att-data-totals">website_sale_order.amount_total</attribute>
        </xpath>
    </template>

    <template id="method_form" inherit_id="payment.method_form">
        <t t-call="payment.form_icon" position="before">
            <t t-if="pm_sudo.fees_service_id and pm_sudo.fees_active and pm_sudo.fees_percent > 0 and website_sale_order">
                <t t-set="method_fees" t-value="pm_sudo.fees_percent"/>
                <span class="badge rounded-pill text-bg-warning">
                    <span class="method_fees" t-out="method_fees" style="white-space: nowrap;"/>
                    <span class="method_fees_text">% will be added on total amount</span>
                    <span class="method_fees_mobile">&#37;% fee</span>
                </span>
            </t>
        </t>
        <xpath expr="//input[@name='o_payment_radio']" position="attributes">
            <attribute name="t-att-data-fees">pm_sudo.fees_percent or 0</attribute>
        </xpath>
    </template>


</odoo>
